#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/../.." && pwd -P)"
cd "$repo_root"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

policy="${AI_WORKFLOW_BRANCH_POLICY:-auto}"

case "$policy" in
  auto|public|dev)
    ;;
  *)
    echo "Invalid AI_WORKFLOW_BRANCH_POLICY: $policy"
    echo "Allowed values: auto, public, dev"
    echo "dev never overrides the actual branch or installation boundary."
    exit 1
    ;;
esac

branch="$(git branch --show-current 2>/dev/null || true)"
parent="$(cd "$repo_root/.." && pwd -P)"
parent_git="$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null || true)"
nested=0
if [[ "$parent_git" == "$parent" ]]; then
  nested=1
fi

# Local Git identity takes precedence. Only verified detached Actions context
# can identify a development merge tree; a PR destination may narrow permission.
if [[ -z "$branch" && "${GITHUB_ACTIONS:-}" == true &&
      "${GITHUB_REPOSITORY:-}" == bracia-plociennik/ai-workflow &&
      "${GITHUB_SHA:-}" == "$(git rev-parse HEAD)" ]]; then
  case "${GITHUB_EVENT_NAME:-}" in
    push)
      [[ "${GITHUB_REF:-}" != refs/heads/dev || "${GITHUB_REF_NAME:-}" != dev ]] || branch=dev
      ;;
    pull_request)
      if [[ "${GITHUB_BASE_REF:-}" == dev && "${GITHUB_REF:-}" =~ ^refs/pull/[0-9]+/merge$ ]]; then
        branch=dev
      fi
      ;;
  esac
fi

allow_workspace=0
origin="$(git remote get-url origin 2>/dev/null || true)"
canonical_origin=0
case "$origin" in
  https://github.com/bracia-plociennik/ai-workflow.git|https://github.com/bracia-plociennik/ai-workflow|git@github.com:bracia-plociennik/ai-workflow.git)
    canonical_origin=1 ;;
esac
if [[ "$policy" != public && "$branch" == dev && "$nested" == 0 &&
      "$canonical_origin" == 1 &&
      "${AI_WORKFLOW_MODE:-auto}" != target &&
      ( -z "${GITHUB_BASE_REF:-}" || "${GITHUB_BASE_REF:-}" == dev ) ]]; then
  allow_workspace=1
fi

tracked_legacy="$(git ls-files -- workspace || true)"
tracked_local_workspace="$(git ls-files -- ai-workflow-workspace || true)"
fail=0

if [[ -n "$tracked_legacy" ]]; then
  echo "Branch policy violation: legacy workspace files are tracked under workspace/."
  echo "Runtime workspace must stay local-only and untracked."
  printf '%s\n' "$tracked_legacy" | sed 's/^/ - /'
  fail=1
fi

if [[ -n "$tracked_local_workspace" && "$allow_workspace" == 0 ]]; then
  echo "Branch policy violation: ai-workflow-workspace/ is tracked."
  echo "Tracked workspace is allowed only on official dev, never on main, other branches, or nested installations."
  printf '%s\n' "$tracked_local_workspace" | sed 's/^/ - /'
  fail=1
fi

if [[ -n "$tracked_local_workspace" && "$allow_workspace" == 1 ]]; then
  if ! "$script_dir/check-workspace-publication"; then
    fail=1
  fi
fi

exit "$fail"
