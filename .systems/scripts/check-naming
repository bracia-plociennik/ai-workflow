#!/usr/bin/env bash
set -euo pipefail

fail=0
project=""
runtime_only=0
scope_root=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --project)
      [[ "$#" -ge 2 ]] || { echo "Missing value for --project" >&2; exit 2; }
      project="$2"
      shift 2
      ;;
    --runtime-only) runtime_only=1; shift ;;
    --scope-root)
      [[ "$#" -ge 2 ]] || { echo "Missing value for --scope-root" >&2; exit 2; }
      scope_root="$2"; shift 2 ;;
    *) echo "Unknown check-naming argument: $1" >&2; exit 2 ;;
  esac
done
if [[ -n "$project" && ! "$project" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Unsafe project slug: $project" >&2
  exit 2
fi
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$script_dir/resolve-workflow-env"
repo_root="$AI_WORKFLOW_HOME"
workspace_home="$AI_WORKFLOW_WORKSPACE_HOME"
cd "$repo_root"

scope_files=""
if [[ "$runtime_only" == 1 ]]; then
  [[ -n "$scope_root" ]] || { echo "--runtime-only requires --scope-root" >&2; exit 2; }
  [[ -z "$project" || "$scope_root" == "projects/$project" ]] || { echo "Project/root conflict" >&2; exit 2; }
  scope_files="$(mktemp)"
  trap 'rm -f "$scope_files"' EXIT
  python3 "$script_dir/lib/validation-scope.py" runtime-files --workspace "$workspace_home" --root "$scope_root" > "$scope_files"
  if [[ "$scope_root" == projects/* ]]; then project="${scope_root#projects/}"; fi
elif [[ -n "$scope_root" ]]; then
  echo "--scope-root requires --runtime-only" >&2
  exit 2
fi

if [[ -d "$workspace_home" ]]; then
  workspace_home="$(cd "$workspace_home" && pwd -P)"
else
  workspace_home=""
fi
if [[ -n "$project" && ( -z "$workspace_home" || ! -d "$workspace_home/projects/$project" ) ]]; then
  echo "Selected project does not exist: $project" >&2
  exit 2
fi

is_exempt_markdown_path() {
  local path="$1"
  local base
  base="$(basename "$path")"

  [[ "$path" == "AGENTS.md" || "$path" == "./AGENTS.md" || "$path" == "HUMANS.md" || "$path" == "./HUMANS.md" || "$base" == "README.md" ]]
}

is_canonical_skill_contract_path() {
  local path="${1#./}"

  if [[ "$path" =~ ^\.systems/ai/skills/[^/]+/SKILL\.md$ ]]; then
    return 0
  fi

  if [[ "$path" =~ ^ai-workflow-workspace/skills/[^/]+/SKILL\.md$ ]]; then
    return 0
  fi

  if [[ -n "$workspace_home" ]]; then
    local absolute_path="$path"
    [[ "$absolute_path" = /* ]] || absolute_path="$repo_root/$absolute_path"
    if [[ "$absolute_path" =~ ^"$workspace_home"/skills/[^/]+/SKILL\.md$ ]]; then
      return 0
    fi
  fi

  return 1
}

is_frozen_eval_input_path() {
  local path="$1"
  local relative
  local eval_root

  [[ -n "$workspace_home" && "$path" == "$workspace_home"/projects/* ]] || return 1
  relative="${path#"$workspace_home"/projects/}"
  if [[ "$relative" =~ ^([^/]+)/evals/([^/]+)/(fixture/|runs/[^/]+/checkout/) ]]; then
    eval_root="$workspace_home/projects/${BASH_REMATCH[1]}/evals/${BASH_REMATCH[2]}"
    [[ -s "$eval_root/freeze.md" ]] && return 0
  fi

  return 1
}

is_exempt_supporting_path() {
  local path="${1#./}"

  case "$path" in
    .systems/ai/skills/*/context/*)
      return 0
      ;;
    .systems/ai/skills/legacy/*)
      return 0
      ;;
    workspace/repo/legacy/*)
      return 0
      ;;
    workspace/repo/context/*)
      return 0
      ;;
    workspace/projects/*/context.md)
      return 1
      ;;
    workspace/projects/*/context/*)
      return 0
      ;;
    .systems/ai/examples/projects/*/context.md)
      return 1
      ;;
    .systems/ai/examples/projects/*/context/*)
      return 0
      ;;
  esac

  if [[ -n "$workspace_home" ]]; then
    local absolute_path="$path"
    [[ "$absolute_path" = /* ]] || absolute_path="$repo_root/$absolute_path"
    case "$absolute_path" in
      "$workspace_home"/skills/*/context/*)
        return 0
        ;;
      "$workspace_home"/repo/legacy/*)
        return 0
        ;;
      "$workspace_home"/repo/context/*)
        return 0
        ;;
      "$workspace_home"/projects/*/context.md)
        return 1
        ;;
      "$workspace_home"/projects/*/context/*)
        return 0
        ;;
    esac
    if is_frozen_eval_input_path "$absolute_path"; then
      return 0
    fi
  fi

  return 1
}

check_markdown_path() {
  local path="$1"
  local source="$2"
  local base
  base="$(basename "$path")"

  [[ "$base" == *.md ]] || return 0

  if is_exempt_markdown_path "$path"; then
    return 0
  fi

  if is_canonical_skill_contract_path "$path"; then
    return 0
  fi

  if is_exempt_supporting_path "$path"; then
    return 0
  fi

  if [[ ! "$base" =~ ^[a-z0-9]+([.-][a-z0-9]+)*\.md$ ]]; then
    echo "Invalid Markdown filename (${source}): ${path#./}"
    fail=1
  fi

  if [[ "$base" == *"_"* ]]; then
    echo "Markdown filename contains underscore (${source}): ${path#./}"
    fail=1
  fi
}

if [[ "$runtime_only" -eq 1 ]]; then
  while IFS= read -r -d '' file; do
    [[ "$file" == *.md ]] || continue
    check_markdown_path "$file" runtime-scope
  done < "$scope_files"
  exit "$fail"
fi

find_prune=(-path ./.git -prune -o -path ./workspace -prune -o -path ./.install-smoke -prune -o -path ./.update-smoke -prune -o)
if [[ -n "$workspace_home" && "$workspace_home" == "$repo_root/"* ]]; then
  find_prune+=(-path "./${workspace_home#"$repo_root"/}" -prune -o)
fi
while IFS= read -r -d '' file; do
  check_markdown_path "$file" "filesystem"
done < <(find . "${find_prune[@]}" -type f -name '*.md' -print0)

if [[ -n "$workspace_home" && -d "$workspace_home" ]]; then
  while IFS= read -r -d '' file; do
    check_markdown_path "$file" "workspace-filesystem"
  done < <(find "$workspace_home" -path "$workspace_home/projects" -prune -o -type f -name '*.md' -print0)
  if [[ -n "$project" ]]; then
    while IFS= read -r -d '' file; do
      check_markdown_path "$file" "workspace-filesystem"
    done < <(find "$workspace_home/projects/$project" -type f -name '*.md' -print0)
  else
    while IFS= read -r -d '' file; do
      check_markdown_path "$file" "workspace-filesystem"
    done < <(find "$workspace_home/projects" -type f -name '*.md' -print0 2>/dev/null || true)
  fi
fi

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  while IFS= read -r -d '' file; do
    check_markdown_path "$file" "git-index"
  done < <(git ls-files -z -- '*.md')
fi

if [[ "$fail" -ne 0 ]]; then
  echo "Naming check failed. If these are case-only or rename-only migrations, stage rename metadata with 'git add -A' before relying on strict git-index validation."
fi

exit "$fail"
