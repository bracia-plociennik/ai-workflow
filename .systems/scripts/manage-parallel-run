#!/usr/bin/env python3
"""Native-free lifecycle entrypoint for explicit owned run records."""
import importlib.util
from pathlib import Path
import sys

sys.dont_write_bytecode = True
path = Path(__file__).resolve().parent / "lib/parallel-orchestration.py"
spec = importlib.util.spec_from_file_location("parallel_orchestration", path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
sys.exit(module.lifecycle_main())
