#!/usr/bin/env bash

# Sourceable shell adapter for the common, non-mutating Python path consumer.
resolve_ai_workflow_env() {
  local resolver_script_dir resolver_home resolver_output resolver_line resolver_key
  local resolver_target="${AI_WORKFLOW_TARGET_ROOT:-}"
  local resolver_mode="${AI_WORKFLOW_MODE:-auto}"
  resolver_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  resolver_home="$(cd "$resolver_script_dir/../.." && pwd -P)"
  if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --target) [[ $# -ge 2 ]] || return 2; resolver_target="$2"; shift 2 ;;
        --mode) [[ $# -ge 2 ]] || return 2; resolver_mode="$2"; shift 2 ;;
        *) echo "Usage: resolve-workflow-env [--target ROOT] [--mode auto|official|target|shared]" >&2; return 2 ;;
      esac
    done
  fi
  local resolver_args=(workflow-env --workflow-home "$resolver_home" --mode "$resolver_mode" --cwd "$PWD" --lines)
  [[ -z "$resolver_target" || "$resolver_mode" == official ]] || resolver_args+=(--target "$resolver_target")
  resolver_output="$(python3 -B "$resolver_script_dir/durable_runtime.py" "${resolver_args[@]}")" || return 2
  while IFS= read -r resolver_line; do
    resolver_key="${resolver_line%%=*}"
    case "$resolver_key" in
      AI_WORKFLOW_MODE_RESOLVED|AI_WORKFLOW_HOME|TARGET_REPO_ROOT|AI_WORKFLOW_WORKSPACE_HOME)
        export "$resolver_key=${resolver_line#*=}" ;;
      *) echo "Invalid Workflow environment output" >&2; return 2 ;;
    esac
  done <<< "$resolver_output"
}

if resolve_ai_workflow_env "$@"; then
  if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    printf 'AI_WORKFLOW_MODE_RESOLVED=%s\nAI_WORKFLOW_HOME=%s\nTARGET_REPO_ROOT=%s\nAI_WORKFLOW_WORKSPACE_HOME=%s\n' \
      "$AI_WORKFLOW_MODE_RESOLVED" "$AI_WORKFLOW_HOME" "$TARGET_REPO_ROOT" "$AI_WORKFLOW_WORKSPACE_HOME"
  fi
else
  if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 2; fi
  exit 2
fi
