#!/usr/bin/env bash
set -euo pipefail

dry_run=0
skip_validation=0
remote_arg=""
branch_arg=""

usage() {
  cat <<'EOF'
Usage: .systems/scripts/update-from-upstream [options]

Options:
  --dry-run              classify paths and print planned update without fetching or merging
  --remote <name>        remote to fetch from (default: upstream tracking remote or origin)
  --branch <name>        branch to merge (default: upstream tracking branch or main)
  --skip-validation      skip post-update validators; unsafe for final PASS
  -h, --help             show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    --remote)
      remote_arg="${2:-}"
      [[ -n "$remote_arg" ]] || { echo "Missing value for --remote"; exit 2; }
      shift 2
      ;;
    --branch)
      branch_arg="${2:-}"
      [[ -n "$branch_arg" ]] || { echo "Missing value for --branch"; exit 2; }
      shift 2
      ;;
    --skip-validation)
      skip_validation=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ai_workflow_home="$(cd "$script_dir/../.." && pwd -P)"
cd "$ai_workflow_home"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "STOP: AI_WORKFLOW_HOME is not a git worktree: $ai_workflow_home"
  exit 1
fi

repo_root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"
if [[ "$repo_root" != "$ai_workflow_home" ]]; then
  echo "STOP: update-from-upstream must run inside the ai-workflow nested clone."
  echo "Expected AI_WORKFLOW_HOME: $ai_workflow_home"
  echo "Git root: $repo_root"
  exit 1
fi

remote="$remote_arg"
branch="$branch_arg"
if [[ -z "$remote" || -z "$branch" ]]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" && "$upstream" == */* ]]; then
    [[ -n "$remote" ]] || remote="${upstream%%/*}"
    [[ -n "$branch" ]] || branch="${upstream#*/}"
  fi
fi
remote="${remote:-origin}"
branch="${branch:-main}"
target_ref="$remote/$branch"

is_protected_path() {
  local path="${1#./}"
  path="${path%/}"

  case "$path" in
    workspace|workspace/*)
      return 0
      ;;
  esac

  return 1
}

protected_root_for_path() {
  local path="${1#./}"
  path="${path%/}"

  case "$path" in
    workspace|workspace/*)
      printf '%s\n' "workspace"
      ;;
  esac
}

add_unique() {
  local item="$1"
  local existing
  for existing in "${unique_items[@]:-}"; do
    [[ "$existing" == "$item" ]] && return 0
  done
  unique_items+=("$item")
}

template_blockers=()
protected_dirty=()
deleted_protected=()

classify_status_path() {
  local status="$1"
  local path="$2"

  [[ -n "$path" ]] || return 0

  if is_protected_path "$path"; then
    protected_dirty+=("$status"$'\t'"$path")
    if [[ "$status" == *D* ]]; then
      deleted_protected+=("$path")
    fi
  else
    template_blockers+=("$status $path")
  fi
}

while IFS= read -r -d '' entry; do
  status="${entry:0:2}"
  path="${entry:3}"
  classify_status_path "$status" "$path"

  if [[ "$status" == R* || "$status" == C* ]]; then
    IFS= read -r -d '' old_path || true
    classify_status_path "$status" "$old_path"
  fi
done < <(git status --porcelain -z)

if [[ "${#template_blockers[@]}" -gt 0 ]]; then
  echo "STOP: system-owned files are dirty. Commit, stash, or discard these before update-from-upstream:"
  printf ' - %s\n' "${template_blockers[@]}"
  exit 1
fi

unique_items=()
[[ -e "workspace" ]] && add_unique "workspace"

for line in "${protected_dirty[@]}"; do
  path="${line#*$'\t'}"
  root="$(protected_root_for_path "$path" || true)"
  [[ -n "${root:-}" ]] && add_unique "$root"
done

echo "AI_WORKFLOW_HOME: $ai_workflow_home"
echo "Update target: $target_ref"
echo "Protected paths:"
if [[ "${#unique_items[@]}" -eq 0 ]]; then
  echo " - none"
else
  printf ' - %s\n' "${unique_items[@]}"
fi

if [[ "$dry_run" -eq 1 ]]; then
  echo "Dry run only. No fetch, merge, restore, or validation was performed."
  exit 0
fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/ai-workflow-update.XXXXXX")"
backup_dir="$tmp/protected"
deleted_file="$tmp/deleted-protected.txt"
mkdir -p "$backup_dir"
restore_needed=0
restore_done=0

restore_protected() {
  [[ "$restore_needed" -eq 1 && "$restore_done" -eq 0 ]] || return 0

  if [[ -n "$(find "$backup_dir" -mindepth 1 -print -quit 2>/dev/null || true)" ]]; then
    (cd "$backup_dir" && tar -cf - .) | tar -xf - -C "$ai_workflow_home"
  fi

  if [[ -f "$deleted_file" ]]; then
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      rm -rf "$ai_workflow_home/$path"
    done < "$deleted_file"
  fi

  restore_done=1
}

cleanup() {
  local status=$?
  if [[ "$status" -ne 0 ]]; then
    restore_protected || true
  fi
  rm -rf "$tmp"
  exit "$status"
}
trap cleanup EXIT

for path in "${unique_items[@]}"; do
  [[ -e "$path" ]] || continue
  mkdir -p "$backup_dir/$(dirname "$path")"
  cp -a "$path" "$backup_dir/$path"
done
: > "$deleted_file"
if [[ "${#deleted_protected[@]}" -gt 0 ]]; then
  printf '%s\n' "${deleted_protected[@]}" > "$deleted_file"
fi
restore_needed=1

if [[ "${#unique_items[@]}" -gt 0 ]]; then
  git reset -q HEAD -- "${unique_items[@]}" || true
  git checkout -q -- "${unique_items[@]}" || true
  git clean -fd -- "${unique_items[@]}" >/dev/null 2>&1 || true
fi

git fetch "$remote" "$branch"
git merge --ff-only FETCH_HEAD

restore_protected

if [[ "$skip_validation" -eq 1 ]]; then
  echo "WARNING: validation skipped. This update result is not eligible for final PASS."
else
  .systems/scripts/validate-workflow
fi

echo "update-from-upstream completed."
