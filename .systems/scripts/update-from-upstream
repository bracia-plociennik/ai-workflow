#!/usr/bin/env bash
set -euo pipefail

dry_run=0
skip_validation=0
remote_arg=""
branch_arg=""

usage() {
  cat <<'EOF'
Usage: .systems/scripts/update-from-upstream [options]

Options:
  --dry-run              classify paths and print planned update without fetching or merging
  --remote <name>        remote to fetch from (default: upstream tracking remote or origin)
  --branch <name>        branch to merge (default: upstream tracking branch or main)
  --skip-validation      skip post-update validators; unsafe for final PASS
  -h, --help             show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    --remote)
      remote_arg="${2:-}"
      [[ -n "$remote_arg" ]] || { echo "Missing value for --remote"; exit 2; }
      shift 2
      ;;
    --branch)
      branch_arg="${2:-}"
      [[ -n "$branch_arg" ]] || { echo "Missing value for --branch"; exit 2; }
      shift 2
      ;;
    --skip-validation)
      skip_validation=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ai_workflow_home="$(cd "$script_dir/../.." && pwd -P)"
cd "$ai_workflow_home"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "STOP: AI_WORKFLOW_HOME is not a git worktree: $ai_workflow_home"
  exit 1
fi

repo_root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"
if [[ "$repo_root" != "$ai_workflow_home" ]]; then
  echo "STOP: update-from-upstream must run inside the ai-workflow nested clone."
  echo "Expected AI_WORKFLOW_HOME: $ai_workflow_home"
  echo "Git root: $repo_root"
  exit 1
fi

remote="$remote_arg"
branch="$branch_arg"
if [[ -z "$remote" || -z "$branch" ]]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" && "$upstream" == */* ]]; then
    [[ -n "$remote" ]] || remote="${upstream%%/*}"
    [[ -n "$branch" ]] || branch="${upstream#*/}"
  fi
fi
remote="${remote:-origin}"
branch="${branch:-main}"
target_ref="$remote/$branch"

template_blockers=()
legacy_workspace_dirty=()

classify_status_path() {
  local status="$1"
  local path="$2"

  [[ -n "$path" ]] || return 0

  case "${path#./}" in
    workspace|workspace/*)
      legacy_workspace_dirty+=("$status $path")
      return 0
      ;;
  esac

  template_blockers+=("$status $path")
}

if [[ -e "workspace" ]]; then
  echo "STOP: legacy workspace found inside AI_WORKFLOW_HOME: $ai_workflow_home/workspace"
  echo "Migrate runtime to AI_WORKFLOW_WORKSPACE_HOME, normally the sibling target-owned ai-workflow-workspace/ directory, before updating."
  echo "The update flow does not backup, restore, normalize, or modify legacy workspace data inside the nested clone."
  exit 1
fi

workspace_home="${AI_WORKFLOW_WORKSPACE_HOME:-}"
if [[ -z "$workspace_home" ]]; then
  parent_root="$(cd "$ai_workflow_home/.." && pwd -P)"
  workspace_home="$parent_root/ai-workflow-workspace"
fi

if [[ -e "$workspace_home" ]]; then
  echo "AI_WORKFLOW_WORKSPACE_HOME: $workspace_home"
  echo "Target-owned workspace is outside the nested clone and will not be touched."
else
  echo "AI_WORKFLOW_WORKSPACE_HOME: $workspace_home (not found)"
  echo "Continuing because update-from-upstream only updates the nested clone. Run .systems/scripts/init-workspace if this is a fresh install."
fi

while IFS= read -r -d '' entry; do
  status="${entry:0:2}"
  path="${entry:3}"
  classify_status_path "$status" "$path"

  if [[ "$status" == R* || "$status" == C* ]]; then
    IFS= read -r -d '' old_path || true
    classify_status_path "$status" "$old_path"
  fi
done < <(git status --porcelain -z)

if [[ "${#legacy_workspace_dirty[@]}" -gt 0 ]]; then
  echo "STOP: legacy workspace changes detected inside the nested clone. Migrate them to AI_WORKFLOW_WORKSPACE_HOME before updating:"
  printf ' - %s\n' "${legacy_workspace_dirty[@]}"
  exit 1
fi

if [[ "${#template_blockers[@]}" -gt 0 ]]; then
  echo "STOP: system-owned files are dirty. Commit, stash, or discard these before update-from-upstream:"
  printf ' - %s\n' "${template_blockers[@]}"
  exit 1
fi

echo "AI_WORKFLOW_HOME: $ai_workflow_home"
echo "Update target: $target_ref"
echo "Protected external workspace: $workspace_home"

if [[ "$dry_run" -eq 1 ]]; then
  echo "Dry run only. No fetch, merge, or validation was performed."
  exit 0
fi

git fetch "$remote" "$branch"
git merge --ff-only FETCH_HEAD

if [[ "$skip_validation" -eq 1 ]]; then
  echo "WARNING: validation skipped. This update result is not eligible for final PASS."
else
  .systems/scripts/validate-workflow
fi

echo "update-from-upstream completed."
