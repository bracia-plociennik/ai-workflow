#!/usr/bin/env bash
set -euo pipefail

dry_run=0
skip_validation=0
remote_arg=""
branch_arg=""
update_result="fail"
update_completion_emitted=0
update_started_at=0

usage() {
  cat <<'EOF'
Usage: .systems/scripts/update-from-upstream [options]

Options:
  --dry-run              classify paths and print planned update without fetching or merging
  --remote <name>        remote to fetch from (default: upstream tracking remote or origin)
  --branch <name>        branch to merge (default: upstream tracking branch or main)
  --skip-validation      skip post-update validators; unsafe for final PASS
  -h, --help             show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    --remote)
      remote_arg="${2:-}"
      [[ -n "$remote_arg" ]] || { echo "Missing value for --remote"; exit 2; }
      shift 2
      ;;
    --branch)
      branch_arg="${2:-}"
      [[ -n "$branch_arg" ]] || { echo "Missing value for --branch"; exit 2; }
      shift 2
      ;;
    --skip-validation)
      skip_validation=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ai_workflow_home="$(cd "$script_dir/../.." && pwd -P)"
cd "$ai_workflow_home"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "STOP: AI_WORKFLOW_HOME is not a git worktree: $ai_workflow_home"
  exit 1
fi

repo_root="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"
if [[ "$repo_root" != "$ai_workflow_home" ]]; then
  echo "STOP: update-from-upstream must run inside the ai-workflow nested clone."
  echo "Expected AI_WORKFLOW_HOME: $ai_workflow_home"
  echo "Git root: $repo_root"
  exit 1
fi

update_started_at=$SECONDS
finish_update() {
  local status="$?"
  if [[ "$update_completion_emitted" -eq 0 ]]; then
    update_completion_emitted=1
    if [[ "$status" -eq 0 && "$update_result" == "pass" ]]; then
      printf 'AI_WORKFLOW_UPDATE_COMPLETE result=pass duration_seconds=%s\n' "$((SECONDS - update_started_at))"
    elif [[ "$update_result" == "skipped" ]]; then
      printf 'AI_WORKFLOW_UPDATE_COMPLETE result=skipped duration_seconds=%s\n' "$((SECONDS - update_started_at))"
    elif [[ "$status" -eq 124 || "$update_result" == "timeout" ]]; then
      printf 'AI_WORKFLOW_UPDATE_COMPLETE result=timeout exit_code=%s duration_seconds=%s\n' "$status" "$((SECONDS - update_started_at))"
    elif [[ "$status" -eq 130 || "$status" -eq 143 || "$update_result" == "interrupted" ]]; then
      printf 'AI_WORKFLOW_UPDATE_COMPLETE result=interrupted exit_code=%s duration_seconds=%s\n' "$status" "$((SECONDS - update_started_at))"
    else
      printf 'AI_WORKFLOW_UPDATE_COMPLETE result=fail exit_code=%s duration_seconds=%s\n' "$status" "$((SECONDS - update_started_at))"
    fi
  fi
}
trap finish_update EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

remote="$remote_arg"
branch="$branch_arg"
if [[ -z "$remote" || -z "$branch" ]]; then
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" && "$upstream" == */* ]]; then
    [[ -n "$remote" ]] || remote="${upstream%%/*}"
    [[ -n "$branch" ]] || branch="${upstream#*/}"
  fi
fi
remote="${remote:-origin}"
branch="${branch:-main}"
target_ref="$remote/$branch"

template_blockers=()
legacy_workspace_dirty=()

classify_status_path() {
  local status="$1"
  local path="$2"

  [[ -n "$path" ]] || return 0

  case "${path#./}" in
    workspace|workspace/*)
      legacy_workspace_dirty+=("$status $path")
      return 0
      ;;
  esac

  template_blockers+=("$status $path")
}

if [[ -e "workspace" ]]; then
  echo "STOP: legacy workspace found inside AI_WORKFLOW_HOME: $ai_workflow_home/workspace"
  echo "Migrate runtime to AI_WORKFLOW_WORKSPACE_HOME, normally the sibling target-owned ai-workflow-workspace/ directory, before updating."
  echo "The update flow does not backup, restore, normalize, or modify legacy workspace data inside the nested clone."
  exit 1
fi

parent_root="$(cd "$ai_workflow_home/.." && pwd -P)"
workspace_home="${AI_WORKFLOW_WORKSPACE_HOME:-}"
if [[ -z "$workspace_home" ]]; then
  workspace_home="$parent_root/ai-workflow-workspace"
fi

if [[ -e "$workspace_home" ]]; then
  workspace_exists=1
  echo "AI_WORKFLOW_WORKSPACE_HOME: $workspace_home"
  echo "Target-owned workspace is outside the nested clone and will not be touched."
else
  workspace_exists=0
  echo "AI_WORKFLOW_WORKSPACE_HOME: $workspace_home (not found)"
  echo "Continuing because update-from-upstream only updates the nested clone. Run phase-0-init if this is a fresh install."
fi

while IFS= read -r -d '' entry; do
  status="${entry:0:2}"
  path="${entry:3}"
  classify_status_path "$status" "$path"

  if [[ "$status" == R* || "$status" == C* ]]; then
    IFS= read -r -d '' old_path || true
    classify_status_path "$status" "$old_path"
  fi
done < <(git status --porcelain -z)

if [[ "${#legacy_workspace_dirty[@]}" -gt 0 ]]; then
  echo "STOP: legacy workspace changes detected inside the nested clone. Migrate them to AI_WORKFLOW_WORKSPACE_HOME before updating:"
  printf ' - %s\n' "${legacy_workspace_dirty[@]}"
  exit 1
fi

if [[ "${#template_blockers[@]}" -gt 0 ]]; then
  echo "STOP: system-owned files are dirty. Commit, stash, or discard these before update-from-upstream:"
  printf ' - %s\n' "${template_blockers[@]}"
  exit 1
fi

echo "AI_WORKFLOW_HOME: $ai_workflow_home"
echo "Update target: $target_ref"
echo "Protected external workspace: $workspace_home"

if [[ "$dry_run" -eq 1 ]]; then
  update_result="skipped"
  echo "Dry run only. No fetch, merge, or validation was performed."
  exit 0
fi

git fetch "$remote" "$branch"

upstream_relation="$(git rev-list --left-right --count HEAD...FETCH_HEAD)"
read -r local_only upstream_only <<< "$upstream_relation"

if [[ "$local_only" -eq 0 && "$upstream_only" -eq 0 ]]; then
  relation="equal"
elif [[ "$local_only" -eq 0 ]]; then
  relation="behind"
elif [[ "$upstream_only" -eq 0 ]]; then
  relation="ahead"
else
  relation="diverged"
fi

printf 'AI_WORKFLOW_UPSTREAM_STATE relation=%s local_only=%s upstream_only=%s\n' \
  "$relation" "$local_only" "$upstream_only"

if [[ "$relation" == "ahead" || "$relation" == "diverged" ]]; then
  echo "STOP: nested AI Workflow clone is not canonical."
  echo "Local system commits must be promoted through the official upstream repository or recorded in AI_WORKFLOW_WORKSPACE_HOME/external-memory/."
  echo "No reset, rebase, merge, workspace write, or validation was performed."
  if [[ "$local_only" -gt 0 ]]; then
    echo "Local-only commits:"
    git log --oneline "FETCH_HEAD..HEAD"
  fi
  exit 1
fi

if [[ "$relation" == "behind" ]]; then
  git merge --ff-only FETCH_HEAD
fi

if [[ "$(git rev-parse HEAD)" != "$(git rev-parse FETCH_HEAD)" ]]; then
  echo "STOP: nested AI Workflow clone did not end at fetched canonical HEAD."
  exit 1
fi

if [[ "$skip_validation" -eq 1 ]]; then
  echo "WARNING: validation skipped. This update result is not eligible for final PASS."
  echo "AI_WORKFLOW_UPDATE_VALIDATION_COMPLETE result=skipped"
  update_result="skipped"
else
  echo "AI_WORKFLOW_UPDATE_VALIDATION_START profile=full progress=summary"
  set +e
  .systems/scripts/validate-workflow --profile full --progress summary
  validation_status=$?
  set -e
  if [[ "$validation_status" -ne 0 ]]; then
    if [[ "$validation_status" -eq 124 ]]; then
      update_result="timeout"
      echo "AI_WORKFLOW_UPDATE_VALIDATION_COMPLETE result=timeout exit_code=124"
    elif [[ "$validation_status" -eq 130 || "$validation_status" -eq 143 ]]; then
      update_result="interrupted"
      echo "AI_WORKFLOW_UPDATE_VALIDATION_COMPLETE result=interrupted exit_code=$validation_status"
    else
      echo "AI_WORKFLOW_UPDATE_VALIDATION_COMPLETE result=fail exit_code=$validation_status"
    fi
    exit "$validation_status"
  fi
  echo "AI_WORKFLOW_UPDATE_VALIDATION_COMPLETE result=pass"
  update_result="pass"
fi

if [[ "$update_result" == "pass" ]]; then
  echo "update-from-upstream completed."
else
  echo "Update completed without validation success; do not treat this run as PASS."
  exit 0
fi
echo
echo "Workspace schema was not modified by update-from-upstream."
echo "Recommended next command to backfill missing target-owned workspace schema files without overwriting existing runtime:"
if [[ "$workspace_home" == "$parent_root/ai-workflow-workspace" ]]; then
  echo "  ai-workflow/.systems/scripts/update-workspace"
else
  printf '  AI_WORKFLOW_WORKSPACE_HOME=%q ai-workflow/.systems/scripts/update-workspace\n' "$workspace_home"
fi
if [[ "$workspace_exists" -eq 0 ]]; then
  echo "If this is a fresh install, run phase-0-init before repo intake."
fi
