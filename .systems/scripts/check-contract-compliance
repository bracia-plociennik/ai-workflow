#!/usr/bin/env bash
set -euo pipefail

fail=0

require_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    echo "Missing contract compliance artifact: $path"
    fail=1
  fi
}

require_ref() {
  local file="$1"
  local pattern="$2"
  local label="$3"

  if [[ ! -f "$file" ]]; then
    echo "Missing file for contract compliance check: $file"
    fail=1
    return 0
  fi

  if ! rg -q "$pattern" "$file"; then
    echo "Missing contract compliance reference in $file: $label"
    fail=1
  fi
}

required_files=(
  ".systems/ai/core/contract-compliance.md"
  ".systems/scripts/check-contract-compliance"
)

for path in "${required_files[@]}"; do
  require_file "$path"
done

required_contract_terms=(
  "advisory-only"
  "Work mode compliance"
  "Knowledge capture"
  "full-project"
  "project-local-micro-task"
  "repo-level-micro-project"
  "workflow-maintenance"
  "phase-6-distillation"
  "phase-7-checkpoint"
  "not-required"
)

for term in "${required_contract_terms[@]}"; do
  require_ref ".systems/ai/core/contract-compliance.md" "$term" "$term"
done

for file in AGENTS.md .systems/ai/core/operating-model.md .systems/ai/core/definition-of-done.md .systems/ai/core/commands.md .systems/ai/core/workflow.md .systems/ai/core/command-routing.md HUMANS.md README.md; do
  require_ref "$file" 'contract-compliance\.md|Contract Compliance|contract compliance' "contract compliance routing"
  require_ref "$file" 'Knowledge capture|knowledge capture' "knowledge capture gate"
done

for template in .systems/ai/templates/projects/micro-task.template.md .systems/ai/templates/micro-projects/micro-project.template.md; do
  require_ref "$template" '## Contract Compliance' "template contract compliance section"
  require_ref "$template" '## Knowledge Capture' "template knowledge capture section"
  require_ref "$template" 'Promote to full workflow' "template promote decision"
done

require_ref ".systems/scripts/validate-workflow" 'check-contract-compliance' "validator chain"
require_ref ".systems/scripts/check-required-artifacts" 'check-contract-compliance' "required artifact list"
require_ref ".systems/scripts/check-validator-smoke-tests" 'contract-compliance' "smoke coverage"

exit "$fail"
