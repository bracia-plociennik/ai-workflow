#!/usr/bin/env bash
set -euo pipefail

if ! command -v rg >/dev/null 2>&1; then
  echo "Missing required command: rg"
  exit 1
fi

.systems/scripts/check-required-artifacts
.systems/scripts/check-prompt-composition
.systems/scripts/check-branch-policy
.systems/scripts/check-naming
.systems/scripts/check-status-consistency
.systems/scripts/check-qa-evidence
.systems/scripts/check-system-insights
.systems/scripts/check-system-skills
.systems/scripts/check-contract-compliance
.systems/scripts/check-knowledge-capture-gate
.systems/scripts/check-default-quality-phase-chaining
.systems/scripts/check-dreaming-mode

fail=0
phases=(
  phase-0-init.md
  phase-0-repo-intake.md
  phase-0-project-workspace.md
  phase-0-idea-validation.md
  phase-1-architecture.md
  phase-1-architecture-qa.md
  phase-1-architecture-fix-loop.md
  phase-2-project-plan.md
  phase-2-plan-qa.md
  phase-2-plan-fix-loop.md
  phase-2-task-packaging.md
  phase-2-packaging-qa.md
  phase-2-package-fix-loop.md
  phase-3-specification.md
  phase-3-spec-qa.md
  phase-3-spec-fix-loop.md
  phase-4-implementation.md
  phase-5-quality.md
  phase-5-fix-loop.md
  phase-6-distillation.md
  phase-7-checkpoint.md
  phase-8-final-check.md
)

requiredHeadings=(
  "## Gate Conditions"
  "### Input required"
  "### Output required"
  "### Pass criteria"
  "### Fail criteria"
  "### Who can approve"
  "### Evidence required"
  "### Next allowed phases"
  "### Stop conditions"
  "### Writes allowed"
)

while IFS= read -r -d '' phaseFile; do
  for heading in "${requiredHeadings[@]}"; do
    if ! rg -q "^${heading}$" "$phaseFile"; then
      echo "Missing gate heading '$heading' in ${phaseFile#./}"
      fail=1
    fi
  done

  if rg -q 'Active request matches this phase|Phase-specific inputs listed below|The phase artifact named by|Follow `.systems/ai/core/workflow.md`|Product-code writes are allowed only in implementation or fix-loop phases that explicitly permit them' "$phaseFile"; then
    echo "Generic gate placeholder remains in ${phaseFile#./}"
    fail=1
  fi
done < <(find .systems/ai/workflow -maxdepth 1 -type f -name 'phase-*.md' -print0)

phaseCount="$(find .systems/ai/workflow -maxdepth 1 -type f -name 'phase-*.md' | wc -l | tr -d ' ')"
if [[ "$phaseCount" != "${#phases[@]}" ]]; then
  echo "Unexpected workflow phase file count: $phaseCount, expected ${#phases[@]}"
  fail=1
fi

for phase in "${phases[@]}"; do
  if ! rg -q "$phase" .systems/ai/core/workflow.md; then
    echo "Phase missing from router: $phase"
    fail=1
  fi

  template=".systems/ai/templates/workflow/${phase%.md}.template.md"
  if [[ ! -f "$template" ]]; then
    echo "Phase template missing for $phase: $template"
    fail=1
  fi
done

for required_init_ref in AGENTS.md README.md HUMANS.md .systems/ai/core/installation.md .systems/ai/core/workflow.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md; do
  if ! rg -q 'phase-0-init|phase 0 init' "$required_init_ref"; then
    echo "Missing phase-0-init reference in $required_init_ref"
    fail=1
  fi
done

for required_init_text in 'legacy-index.md' 'blocked-owner-merge' 'ready-for-repo-intake' 'context/data only' 'phase-0-repo-intake'; do
  if ! rg -q "$required_init_text" .systems/ai/workflow/phase-0-init.md .systems/ai/templates/workflow/phase-0-init.template.md .systems/scripts/init-workspace .systems/ai/core/installation.md .systems/ai/core/command-routing.md; then
    echo "Missing phase-0-init bootstrap text: $required_init_text"
    fail=1
  fi
done

root_agents_template=".systems/ai/templates/root-agents.template.md"
for required_root_ref in 'ai-workflow/AGENTS.md' 'AI_WORKFLOW_HOME' 'AI_WORKFLOW_WORKSPACE_HOME' 'TARGET_REPO_ROOT' 'cd ai-workflow'; do
  if ! rg -q "$required_root_ref" "$root_agents_template"; then
    echo "Root AGENTS template missing required nested-clone ref: $required_root_ref"
    fail=1
  fi
done

workspace_phase=".systems/ai/workflow/phase-0-project-workspace.md"
workspace_template=".systems/ai/templates/workflow/phase-0-project-workspace.template.md"
for required_workspace_ref in 'tasks/' 'micro-tasks.md' 'micro-tasks/' 'change-requests.md' 'change-requests/' 'reviews/' 'autopilot/README.md' 'autopilot/runs/'; do
  if ! rg -q "$required_workspace_ref" "$workspace_phase"; then
    echo "Project workspace phase missing required workspace ref: $required_workspace_ref"
    fail=1
  fi

  if ! rg -q "$required_workspace_ref" "$workspace_template"; then
    echo "Project workspace template missing required workspace ref: $required_workspace_ref"
    fail=1
  fi
done

for required_change_ref in '.systems/ai/core/change-requests.md' 'change request' 'final-owner-yes'; do
  if ! rg -q "$required_change_ref" .systems/ai/workflow/phase-8-final-check.md; then
    echo "Final check missing change request ref: $required_change_ref"
    fail=1
  fi

  if ! rg -q "$required_change_ref" .systems/ai/core/command-routing.md; then
    echo "Command routing missing change request ref: $required_change_ref"
    fail=1
  fi
done

response_contract=".systems/ai/core/response-contract.md"
for required_response_contract_text in 'Co dalej?' 'Rekomendacja:' 'Alternatywa:' 'Napisz:' 'Recommendation Sources' 'Alternative Selection'; do
  if ! rg -q "$required_response_contract_text" "$response_contract"; then
    echo "Response contract missing required text: $required_response_contract_text"
    fail=1
  fi
done

for required_response_contract_ref in AGENTS.md .systems/ai/core/operating-model.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md; do
  if ! rg -q '.systems/ai/core/response-contract.md' "$required_response_contract_ref"; then
    echo "Missing response contract reference in $required_response_contract_ref"
    fail=1
  fi
done

for required_task_intake_ref in AGENTS.md .systems/ai/core/command-routing.md .systems/ai/core/operating-model.md .systems/ai/core/response-contract.md .systems/ai/core/workflow.md; do
  if ! rg -q '.systems/ai/core/task-intake.md' "$required_task_intake_ref"; then
    echo "Missing task intake reference in $required_task_intake_ref"
    fail=1
  fi
done

for required_task_intake_text in 'Co zostaje' 'Co jest słabe / do poprawy lub usunięcia' 'Czego brakuje' 'Blokery / decyzje' 'Rekomendowany routing'; do
  if ! rg -q "$required_task_intake_text" .systems/ai/core/task-intake.md .systems/ai/core/command-routing.md .systems/ai/core/response-contract.md; then
    echo "Missing task intake validation text: $required_task_intake_text"
    fail=1
  fi
done

parallel_policy=".systems/ai/core/parallel-work-policy.md"
if [[ ! -f "$parallel_policy" ]]; then
  echo "Missing parallel work policy: $parallel_policy"
  fail=1
fi

for required_parallel_ref in AGENTS.md HUMANS.md .systems/ai/core/operating-model.md .systems/ai/core/workflow.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md; do
  if ! rg -q 'parallel-work-policy.md' "$required_parallel_ref"; then
    echo "Missing parallel work policy reference in $required_parallel_ref"
    fail=1
  fi
done

for required_parallel_text in 'status-only' 'write set' 'repo focus snapshot' 'Project status' 'memory router'; do
  if ! rg -qi "$required_parallel_text" "$parallel_policy"; then
    echo "Parallel work policy missing required text: $required_parallel_text"
    fail=1
  fi
done

for required_autopilot_readiness_ref in .systems/ai/core/autopilot.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md .systems/ai/templates/autopilot/run-readme.template.md .systems/ai/templates/autopilot/state.template.md; do
  if ! rg -q 'readiness.md|readiness-result|readiness audit' "$required_autopilot_readiness_ref"; then
    echo "Missing autopilot readiness reference in $required_autopilot_readiness_ref"
    fail=1
  fi
done

for required_autopilot_readiness_text in 'readiness-result: ready' 'blocked' 'awaiting-owner' 'owner-decisions' 'external-effects'; do
  if ! rg -q "$required_autopilot_readiness_text" .systems/ai/core/autopilot.md .systems/ai/templates/autopilot/readiness.template.md; then
    echo "Missing autopilot readiness text: $required_autopilot_readiness_text"
    fail=1
  fi
done

for required_autopilot_range_ref in .systems/ai/core/autopilot.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md .systems/ai/core/guide.md .systems/ai/templates/autopilot/readiness.template.md .systems/ai/templates/autopilot/state.template.md .systems/ai/templates/autopilot/run-readme.template.md; do
  if ! rg -q 'planning-range' "$required_autopilot_range_ref"; then
    echo "Missing planning-range reference in $required_autopilot_range_ref"
    fail=1
  fi

  if ! rg -q 'implementation-range' "$required_autopilot_range_ref"; then
    echo "Missing implementation-range reference in $required_autopilot_range_ref"
    fail=1
  fi
done

for required_autopilot_owner_only_text in 'owner-triggered only' 'must not automatically run `phase-8-final-check`' 'stop before phase 8'; do
  if ! rg -q "$required_autopilot_owner_only_text" .systems/ai/core/autopilot.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md .systems/ai/templates/autopilot/readiness.template.md; then
    echo "Missing owner-only final check text: $required_autopilot_owner_only_text"
    fail=1
  fi
done

for required_ownership_ref in AGENTS.md .systems/ai/core/installation.md .systems/ai/core/update-from-upstream.md .systems/ai/core/operating-model.md; do
  if ! rg -q 'AI_WORKFLOW_WORKSPACE_HOME/skills/' "$required_ownership_ref"; then
    echo "Missing workspace skills reference in $required_ownership_ref"
    fail=1
  fi

  if ! rg -q 'AI_WORKFLOW_WORKSPACE_HOME/external-memory/' "$required_ownership_ref"; then
    echo "Missing workspace external memory reference in $required_ownership_ref"
    fail=1
  fi

  if ! rg -q 'AI_WORKFLOW_WORKSPACE_HOME/system-insights/' "$required_ownership_ref"; then
    echo "Missing workspace system insights reference in $required_ownership_ref"
    fail=1
  fi
done

for required_skill_contract_ref in AGENTS.md .systems/ai/core/operating-model.md .systems/ai/skills/README.md .systems/ai/core/version.md .systems/ai/core/changelog.md; do
  if ! rg -q 'SKILL\.md' "$required_skill_contract_ref"; then
    echo "Missing system skill SKILL.md contract reference in $required_skill_contract_ref"
    fail=1
  fi
done

for required_skill_context_ref in AGENTS.md .systems/ai/core/operating-model.md .systems/ai/core/command-routing.md .systems/ai/skills/README.md .systems/ai/skills/skill-creator/SKILL.md .systems/ai/templates/workspace/skills/README.md .systems/ai/core/version.md .systems/ai/core/changelog.md; do
  if ! rg -q 'skill-intake-plan\.md' "$required_skill_context_ref"; then
    echo "Missing skill context intake reference in $required_skill_context_ref"
    fail=1
  fi

  if ! rg -q 'context/' "$required_skill_context_ref"; then
    echo "Missing skill context source reference in $required_skill_context_ref"
    fail=1
  fi
done

for required_skill_validator_ref in .systems/scripts/check-required-artifacts .systems/scripts/check-validator-smoke-tests .systems/ai/core/commands.md; do
  if ! rg -q 'check-system-skills' "$required_skill_validator_ref"; then
    echo "Missing check-system-skills validator chain reference in $required_skill_validator_ref"
    fail=1
  fi
done

for required_system_insights_ref in AGENTS.md HUMANS.md README.md .systems/ai/core/workflow.md .systems/ai/core/command-routing.md .systems/ai/core/guide.md .systems/ai/core/memory.md .systems/ai/core/version.md .systems/ai/core/changelog.md; do
  if ! rg -q 'System Insights|system-insights' "$required_system_insights_ref"; then
    echo "Missing System Insights reference in $required_system_insights_ref"
    fail=1
  fi
done

for required_contract_ref in AGENTS.md HUMANS.md README.md .systems/ai/core/operating-model.md .systems/ai/core/definition-of-done.md .systems/ai/core/commands.md .systems/ai/core/workflow.md .systems/ai/core/command-routing.md .systems/ai/core/version.md .systems/ai/core/changelog.md; do
  if ! rg -q 'contract-compliance|Contract Compliance|contract compliance' "$required_contract_ref"; then
    echo "Missing contract compliance reference in $required_contract_ref"
    fail=1
  fi

  if ! rg -q 'Knowledge capture|knowledge capture' "$required_contract_ref"; then
    echo "Missing knowledge capture reference in $required_contract_ref"
    fail=1
  fi
done

for required_update_workspace_ref in README.md HUMANS.md .systems/ai/core/installation.md .systems/ai/core/update-from-upstream.md .systems/ai/core/command-routing.md; do
  if ! rg -q 'update-workspace' "$required_update_workspace_ref"; then
    echo "Missing update-workspace reference in $required_update_workspace_ref"
    fail=1
  fi
done

if ! rg -q 'Do not edit `.systems/\*\*`' AGENTS.md; then
  echo "AGENTS.md missing target-repo .systems read-only rule"
  fail=1
fi

if ! rg -q 'must not modify it|does not touch `AI_WORKFLOW_WORKSPACE_HOME/\*\*`|does not edit workspace legacy files' .systems/ai/core/update-from-upstream.md; then
  echo "Update policy missing external workspace no-touch rule"
  fail=1
fi

for required_public_model_ref in README.md HUMANS.md AGENTS.md .systems/ai/core/installation.md .systems/ai/core/update-from-upstream.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md .systems/ai/core/repo-intake.md; do
  if ! rg -q 'AI_WORKFLOW_WORKSPACE_HOME|ai-workflow-workspace' "$required_public_model_ref"; then
    echo "Missing AI_WORKFLOW_WORKSPACE_HOME reference in $required_public_model_ref"
    fail=1
  fi
done

for required_repository_mode_ref in README.md HUMANS.md AGENTS.md .systems/ai/core/installation.md .systems/ai/core/update-from-upstream.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md .systems/ai/core/version.md .systems/ai/core/changelog.md; do
  if ! rg -q 'repository-modes.md|official repo mode|target repo mode|AI_WORKFLOW_MODE' "$required_repository_mode_ref"; then
    echo "Missing repository mode reference in $required_repository_mode_ref"
    fail=1
  fi
done

for required_repository_mode_text in 'Official Repo Mode' 'Target Repo Mode' 'AI_WORKFLOW_MODE=auto|official|target' 'There is no inner `ai-workflow/` directory' 'resolve-workflow-env'; do
  if ! rg -q "$required_repository_mode_text" .systems/ai/core/repository-modes.md; then
    echo "Repository modes doc missing required text: $required_repository_mode_text"
    fail=1
  fi
done

for required_resolver_ref in .systems/scripts/check-naming .systems/scripts/check-status-consistency .systems/scripts/check-qa-evidence; do
  if ! rg -q 'resolve-workflow-env' "$required_resolver_ref"; then
    echo "Validator missing workflow env resolver: $required_resolver_ref"
    fail=1
  fi
done

for required_install_ref in README.md HUMANS.md .systems/ai/core/installation.md .systems/ai/templates/root-agents.template.md; do
  if ! rg -q '.git/info/exclude' "$required_install_ref"; then
    echo "Missing local-only .git/info/exclude install rule in $required_install_ref"
    fail=1
  fi
done

if rg -q 'printf "\\n# Local AI Workflow nested clone\\n/ai-workflow/\\n" >> \.gitignore' README.md HUMANS.md .systems/ai/core/installation.md; then
  echo "Old committed .gitignore install flow remains"
  fail=1
fi

for required_branch_policy_ref in README.md .systems/ai/core/installation.md .systems/ai/core/version.md .systems/ai/core/changelog.md; do
  if ! rg -q 'check-branch-policy|AI_WORKFLOW_BRANCH_POLICY|ai-workflow-workspace' "$required_branch_policy_ref"; then
    echo "Missing branch policy reference in $required_branch_policy_ref"
    fail=1
  fi
done

if [[ "${AI_WORKFLOW_SKIP_SMOKE_TESTS:-0}" != "1" ]]; then
  .systems/scripts/check-validator-smoke-tests
fi

exit "$fail"
