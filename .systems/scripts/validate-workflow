#!/usr/bin/env bash
set -euo pipefail

profile="standard"
project=""
checks=""
scope_manifest=""
scope_plan=""
scope_executed=""
scope_current_id=""
explain=0
timing_output=""
progress="summary"
timeout_seconds="1200"
execution_plan=""
evidence_output=""
receipt_key_file=""
reuse_record=""
source_receipt=""
source_start=""
executed_checks=""

validation_started=0
completion_emitted=0
current_stage="startup"
current_check="none"

usage() {
  cat <<'EOF'
Usage:
  .systems/scripts/validate-workflow [--profile full|standard|scoped|fast] [--project slug] [--checks check-a,check-b] [--scope-manifest path] [--timing-output path] [--progress quiet|summary|verbose] [--timeout-seconds seconds] [--explain]

Profiles:
  standard  Core validator/structure checks without embedded smoke tests. Default daily validator.
  full      Complete validation, including check-validator-smoke-tests. Explicit heavy validator.
  scoped    Explicit --checks plus declared dependency closure. Coverage requires a current manifest.
  fast      Cheap sanity checks. Iteration only.

Evidence:
  scoped --execution-plan path --evidence-output path --receipt-key-file path [--reuse-record path]
  full --source-receipt path --receipt-key-file path
  Evidence outputs must be new files in ignored workspace or system temporary storage.
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --execution-plan|--evidence-output|--receipt-key-file|--reuse-record|--source-receipt)
      [[ "$#" -ge 2 ]] || { echo "Missing evidence argument" >&2; exit 1; }
      case "$1" in
        --execution-plan) execution_plan="$2" ;;
        --evidence-output) evidence_output="$2" ;;
        --receipt-key-file) receipt_key_file="$2" ;;
        --reuse-record) reuse_record="$2" ;;
        --source-receipt) source_receipt="$2" ;;
      esac
      shift 2
      ;;
    --profile)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for --profile"
        exit 1
      fi
      profile="$2"
      shift 2
      ;;
    --project)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for --project"
        exit 1
      fi
      project="$2"
      shift 2
      ;;
    --checks)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for --checks"
        exit 1
      fi
      checks="$2"
      shift 2
      ;;
    --scope-manifest)
      [[ "$#" -ge 2 ]] || { echo "Missing value for --scope-manifest" >&2; exit 1; }
      scope_manifest="$2"
      shift 2
      ;;
    --explain)
      explain=1
      shift
      ;;
    --timing-output)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for --timing-output"
        exit 1
      fi
      timing_output="$2"
      shift 2
      ;;
    --progress)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for --progress"
        exit 1
      fi
      progress="$2"
      shift 2
      ;;
    --timeout-seconds)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for --timeout-seconds"
        exit 1
      fi
      timeout_seconds="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown validate-workflow argument: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ -n "$project" && ! "$project" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Unsafe project slug: $project"
  exit 1
fi

case "$profile" in
  full|standard|scoped|fast)
    ;;
  *)
    echo "Unknown validation profile: $profile"
    exit 1
    ;;
esac

case "$progress" in
  quiet|summary|verbose)
    ;;
  *)
    echo "Unknown progress mode: $progress"
    exit 1
    ;;
esac

if ! [[ "$timeout_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || [[ "$timeout_seconds" == "0" || "$timeout_seconds" == "0.0" ]]; then
  echo "--timeout-seconds must be greater than zero"
  exit 1
fi

if [[ -n "$checks" && "$profile" != "scoped" ]]; then
  echo "--checks is valid only with --profile scoped"
  exit 1
fi

if [[ "$profile" == "scoped" && -z "$checks" && -z "$execution_plan" ]]; then
  echo "--profile scoped requires --checks <check-a,check-b>"
  exit 1
fi

if [[ -n "$scope_manifest" && "$profile" != "scoped" ]]; then
  echo "--scope-manifest is valid only with --profile scoped" >&2
  exit 1
fi
source "$(dirname "$0")/resolve-workflow-env"

if [[ -n "$execution_plan" ]]; then
  [[ "$profile" == scoped && -z "$checks$scope_manifest$source_receipt$timing_output$project" && -n "$evidence_output" && -n "$receipt_key_file" ]] || {
    echo "Execution plan requires scoped iteration, output/key and no other scope" >&2; exit 1;
  }
  reuse_args=()
  [[ -z "$reuse_record" ]] || reuse_args+=(--reuse "$reuse_record")
fi
[[ -n "$execution_plan" || -z "$reuse_record$evidence_output" ]] || { echo "Reuse requires an execution plan" >&2; exit 1; }
if [[ -n "$source_receipt" ]]; then
  [[ "$profile" == full && -n "$receipt_key_file" && "${AI_WORKFLOW_SKIP_SMOKE_TESTS:-0}" != 1 ]] || {
    echo "Source receipt requires fresh full validation and key" >&2; exit 1;
  }
  source_start="$(mktemp)"
  rm "$source_start"
  python3 "$AI_WORKFLOW_HOME/.systems/scripts/lib/execution-efficiency.py" preflight --output "$source_receipt"
  python3 "$AI_WORKFLOW_HOME/.systems/scripts/lib/execution-efficiency.py" source-start --output "$source_start" --key-file "$receipt_key_file"
elif [[ -n "$receipt_key_file" && -z "$execution_plan" ]]; then
  echo "Receipt key requires an execution plan or source receipt" >&2; exit 1
fi

if ! command -v rg >/dev/null 2>&1; then
  echo "Missing required command: rg"
  exit 1
fi

validation_started=1
printf 'AI_WORKFLOW_VALIDATE_START profile=%s progress=%s\n' "$profile" "$progress"

finish_validation() {
  local status="$?"
  local result="fail"
  if [[ "$status" -eq 0 ]]; then
    result="pass"
  elif [[ "$status" -eq 124 ]]; then
    result="timeout"
  elif [[ "$status" -eq 130 || "$status" -eq 143 ]]; then
    result="interrupted"
  fi
  if [[ -n "$scope_plan" ]]; then
    if ! python3 .systems/scripts/lib/validation-scope.py finish --repo "$TARGET_REPO_ROOT" --workspace "$AI_WORKFLOW_WORKSPACE_HOME" --plan "$scope_plan" --status "$status" --executed "$scope_executed"; then
      if [[ "$status" -eq 0 ]]; then
        status=1
        result="fail"
      fi
    fi
  fi
  if [[ -n "$timing_output" && "${timing_initialized:-0}" -eq 1 ]]; then
    local final_source_digest=""
    final_source_digest="$(.systems/scripts/report-validation-comparison source-digest)" || final_source_digest="unavailable"
    if [[ "$final_source_digest" != "$timing_source_digest" ]]; then
      echo "Validation source changed during timed run; result is incomplete" >&2
      status=1
      result="fail"
    fi
    if ! python3 "$timing_helper" record "$timing_output" "$timing_run_id" validation-wall wall "$result" "$profile" wall none "$timing_wall_start"; then
      echo "Validation timing wall record failed" >&2
      status=1
      result="fail"
    fi
  fi
  if [[ -n "$source_start" ]]; then
    if ! python3 .systems/scripts/lib/execution-efficiency.py source-finish --start "$source_start" --output "$source_receipt" --key-file "$receipt_key_file" --status "$status" --checks "$executed_checks"; then
      if [[ "$status" -eq 0 ]]; then
        status=1
        result="fail"
      fi
    fi
    rm -f "$source_start"
  fi
  if [[ "$validation_started" -eq 1 && "$completion_emitted" -eq 0 ]]; then
    completion_emitted=1
    printf 'AI_WORKFLOW_VALIDATE_COMPLETE profile=%s result=%s exit_code=%s duration_seconds=%s stage=%s check=%s\n' \
      "$profile" "$result" "$status" "$((SECONDS - validation_started_at))" "$current_stage" "$current_check"
  fi
  trap - EXIT
  exit "$status"
}

validation_started_at=$SECONDS
trap finish_validation EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -n "$execution_plan" ]]; then
  current_stage="iteration-plan"
  current_check="execution-efficiency"
  [[ "$explain" != 1 ]] || echo 'Execution plan: iteration-only; coverage unverified; final validation evidence: no'
  python3 "$AI_WORKFLOW_HOME/.systems/scripts/lib/execution-efficiency.py" execute --plan "$execution_plan" --output "$evidence_output" --key-file "$receipt_key_file" --progress "$progress" ${reuse_args[@]+"${reuse_args[@]}"}
  exit 0
fi

if [[ "$profile" == full && -z "$source_start" ]]; then
  current_stage="preflight"
  current_check="execution-capabilities"
  python3 "$AI_WORKFLOW_HOME/.systems/scripts/lib/execution-efficiency.py" preflight
fi

timing_helper=".systems/scripts/lib/validation-timing.py"
timing_run_id="$(date -u +%Y%m%dT%H%M%S)-$$"
timing_wall_start=""
timing_initialized=0
if [[ -n "$timing_output" ]]; then
  timing_wall_start="$(python3 "$timing_helper" now)"
  python3 "$timing_helper" init "$timing_output"
  timing_output="$(cd "$(dirname "$timing_output")" && pwd -P)/$(basename "$timing_output")"
  timing_source_digest="$(.systems/scripts/report-validation-comparison source-digest)"
  timing_run_id="$timing_source_digest-$timing_run_id"
  timing_initialized=1
  export AI_WORKFLOW_TIMING_RUN_ID="$timing_run_id"
fi

record_timing() {
  local check_name="$1"
  local started_ns="$2"
  local result="$3"
  [[ -n "$timing_output" ]] || return 0
  local group="validator"
  [[ "$check_name" == "check-validator-smoke-tests" ]] && group="smoke"
  python3 "$timing_helper" record "$timing_output" "$timing_run_id" "$check_name" "$group" "$result" "$profile" child validation-wall "$started_ns"
}

run_cmd() {
  local started=$SECONDS
  local started_ns=""
  [[ -z "$timing_output" ]] || started_ns="$(python3 "$timing_helper" now)"
  local status
  current_stage="validator"
  current_check="$*"
  if [[ "$progress" != "quiet" ]]; then
    printf 'AI_WORKFLOW_VALIDATE_PROGRESS stage=%s check=%s status=started\n' "$current_stage" "$current_check"
  fi
  if [[ "$explain" == "1" ]]; then
    printf '+ %s\n' "$*"
  fi
  set +e
  if [[ "$1" == ".systems/scripts/check-validator-smoke-tests" && -n "$timing_output" ]]; then
    AI_WORKFLOW_TIMING_OUTPUT="$timing_output" .systems/scripts/run-with-timeout --timeout-seconds "$timeout_seconds" "$@" --progress "$progress"
  elif [[ "$1" == ".systems/scripts/check-validator-smoke-tests" ]]; then
    .systems/scripts/run-with-timeout --timeout-seconds "$timeout_seconds" "$@" --progress "$progress"
  else
    .systems/scripts/run-with-timeout --timeout-seconds "$timeout_seconds" "$@"
  fi
  status=$?
  set -e
  if [[ "$status" -eq 0 ]]; then
    executed_checks="${executed_checks:+$executed_checks,}$(basename "$1")"
  fi
  record_timing "${scope_current_id:-$(basename "$1")}" "$started_ns" "$([[ "$status" -eq 0 ]] && echo pass || echo fail)"
  if [[ "$progress" != "quiet" ]]; then
    printf 'AI_WORKFLOW_VALIDATE_PROGRESS stage=%s check=%s status=%s duration_seconds=%s\n' \
      "$current_stage" "$current_check" "$([[ "$status" -eq 0 ]] && echo pass || echo fail)" "$((SECONDS - started))"
  fi
  return "$status"
}

explain_profile() {
  if [[ "$explain" != "1" ]]; then
    return 0
  fi

  if [[ -n "$project" ]]; then
    echo "Runtime project scope: $project (product checks remain global)"
  fi

  case "$profile" in
    full)
      echo "Validation profile: full"
      if [[ "${AI_WORKFLOW_SKIP_SMOKE_TESTS:-0}" == "1" ]]; then
        echo "Smoke tests: skipped by AI_WORKFLOW_SKIP_SMOKE_TESTS=1"
        echo "Final validation evidence: no, unless owner explicitly accepts residual risk"
      else
        echo "Smoke tests: run"
        echo "Final validation evidence: yes"
      fi
      ;;
    standard)
      echo "Validation profile: standard"
      echo "Smoke tests: skipped"
      echo "Final validation evidence: yes for ordinary work; no when a full-required gate applies"
      ;;
    scoped)
      echo "Validation profile: scoped"
      echo "Scoped checks: $checks"
      echo "Smoke tests: skipped"
      echo "Final validation evidence: no, unless owner explicitly accepts narrow validation with residual risk"
      echo "Coverage and runtime-only checkpoint eligibility are reported separately after manifest/dependency verification. No manifest: unverified."
      ;;
    fast)
      echo "Validation profile: fast"
      echo "Smoke tests: skipped"
      echo "Final validation evidence: no, iteration only"
      ;;
  esac
}

run_runtime_check() {
  local check_path="$1"
  if [[ -n "$project" ]]; then
    run_cmd "$check_path" --project "$project"
  else
    run_cmd "$check_path"
  fi
}

run_fast_checks() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    run_cmd git diff --check
  elif [[ "$explain" == "1" ]]; then
    echo "+ git diff --check (skipped: not a git repository)"
  fi
  run_cmd .systems/scripts/check-required-artifacts
  run_cmd .systems/scripts/check-branch-policy
  run_runtime_check .systems/scripts/check-naming
  run_runtime_check .systems/scripts/check-status-consistency
  run_runtime_check .systems/scripts/check-qa-evidence
  run_cmd .systems/scripts/check-full-qa-verification
  run_cmd .systems/scripts/check-contract-compliance
}

run_core_validators() {
  run_cmd .systems/scripts/check-execution-efficiency
  run_cmd .systems/scripts/check-required-artifacts
  run_cmd .systems/scripts/check-prompt-composition
  run_cmd .systems/scripts/check-branch-policy
  run_runtime_check .systems/scripts/check-naming
  run_runtime_check .systems/scripts/check-status-consistency
  run_runtime_check .systems/scripts/check-qa-evidence
  run_cmd .systems/scripts/check-full-qa-verification
  run_cmd .systems/scripts/check-system-insights
  run_cmd .systems/scripts/check-system-skills
  run_cmd .systems/scripts/check-contract-compliance
  run_cmd .systems/scripts/check-knowledge-capture-gate
  run_cmd .systems/scripts/check-default-quality-phase-chaining
  run_cmd .systems/scripts/check-dreaming-mode
  run_cmd .systems/scripts/check-global-quality-review-stance
  run_cmd .systems/scripts/check-review-completeness-gate
  run_cmd .systems/scripts/check-intent-plan-spec-compliance-review
  run_cmd .systems/scripts/check-implementation-slicing
  run_cmd .systems/scripts/check-plan-quality-contract
  run_cmd .systems/scripts/check-validation-profiles
  run_cmd .systems/scripts/check-knowledge-capture-reminder
  run_cmd .systems/scripts/check-instruction-adherence-refresh
  run_cmd .systems/scripts/check-owner-decision-checkpoints
  run_cmd .systems/scripts/check-execution-modes
  run_cmd .systems/scripts/check-intent-to-execution-brief
  run_cmd .systems/scripts/check-request-batch-triage
  run_cmd .systems/scripts/check-response-evidence-trace
  run_cmd .systems/scripts/check-phase-skill-discovery
  run_cmd .systems/scripts/check-default-quality-closure
  run_cmd .systems/scripts/check-default-idea-validation-opt-out
  run_cmd .systems/scripts/check-end-of-task-capture
  run_cmd .systems/scripts/check-cross-system-upgrade-handoff
  run_cmd .systems/scripts/check-worktree-bootstrap
  run_cmd .systems/scripts/check-validation-routing
  run_cmd .systems/scripts/check-model-selection-guidance
  run_cmd .systems/scripts/check-delivery-constraints
  run_runtime_check .systems/scripts/check-distillation-state
  run_cmd .systems/scripts/check-workspace-freshness
  run_cmd .systems/scripts/check-contract-topology
  run_cmd .systems/scripts/check-validation-observability
  run_cmd .systems/scripts/check-validation-completion
  run_cmd .systems/scripts/check-skill-evaluation-contract
  run_cmd .systems/scripts/check-runtime-integrity
  run_cmd .systems/scripts/check-parallel-task-orchestration
  run_cmd .systems/scripts/check-phase-commit-policy
}

explain_profile

if [[ "$profile" == "fast" ]]; then
  current_stage="fast-profile"
  run_fast_checks
  exit 0
fi

if [[ "$profile" == "scoped" ]]; then
  current_stage="scoped-profile"
  scope_args=(--checks "$checks" --repo "$TARGET_REPO_ROOT" --workspace "$AI_WORKFLOW_WORKSPACE_HOME")
  [[ -z "$scope_manifest" ]] || scope_args+=(--manifest "$scope_manifest")
  [[ -z "$project" ]] || scope_args+=(--project "$project")
  scope_plan="$(python3 .systems/scripts/lib/validation-scope.py plan "${scope_args[@]}")"
  scope_lines="$(python3 .systems/scripts/lib/validation-scope.py lines --plan "$scope_plan")"
  while IFS=$'\t' read -r check_name scope_root scope_project scope_current_id; do
    check_args=()
    if [[ "$scope_root" != "-" ]]; then
      check_args+=(--runtime-only --scope-root "$scope_root")
    elif [[ "$scope_project" != "-" ]]; then
      case "$check_name" in
        check-naming|check-status-consistency|check-qa-evidence|check-distillation-state) check_args+=(--project "$scope_project") ;;
      esac
    fi
    scope_executed="${scope_executed:+$scope_executed,}$scope_current_id"
    run_cmd ".systems/scripts/$check_name" ${check_args[@]+"${check_args[@]}"}
  done <<< "$scope_lines"
  scope_current_id=""
  exit 0
fi

run_core_validators

fail=0
current_stage="structural-checks"
phases=(
  phase-0-init.md
  phase-0-repo-intake.md
  phase-0-project-workspace.md
  phase-0-idea-validation.md
  phase-1-architecture.md
  phase-1-architecture-qa.md
  phase-1-architecture-fix-loop.md
  phase-2-project-plan.md
  phase-2-plan-qa.md
  phase-2-plan-fix-loop.md
  phase-2-task-packaging.md
  phase-2-packaging-qa.md
  phase-2-package-fix-loop.md
  phase-3-specification.md
  phase-3-spec-qa.md
  phase-3-spec-fix-loop.md
  phase-4-implementation.md
  phase-5-quality.md
  phase-5-fix-loop.md
  phase-6-distillation.md
  phase-7-checkpoint.md
  phase-8-final-check.md
)

requiredHeadings=(
  "## Gate Conditions"
  "### Input required"
  "### Output required"
  "### Pass criteria"
  "### Fail criteria"
  "### Who can approve"
  "### Evidence required"
  "### Next allowed phases"
  "### Stop conditions"
  "### Writes allowed"
)

while IFS= read -r -d '' phaseFile; do
  for heading in "${requiredHeadings[@]}"; do
    if ! rg -q "^${heading}$" "$phaseFile"; then
      echo "Missing gate heading '$heading' in ${phaseFile#./}"
      fail=1
    fi
  done

  if rg -q 'Active request matches this phase|Phase-specific inputs listed below|The phase artifact named by|Follow `.systems/ai/core/workflow.md`|Product-code writes are allowed only in implementation or fix-loop phases that explicitly permit them' "$phaseFile"; then
    echo "Generic gate placeholder remains in ${phaseFile#./}"
    fail=1
  fi
done < <(find .systems/ai/workflow -maxdepth 1 -type f -name 'phase-*.md' -print0)

phaseCount="$(find .systems/ai/workflow -maxdepth 1 -type f -name 'phase-*.md' | wc -l | tr -d ' ')"
if [[ "$phaseCount" != "${#phases[@]}" ]]; then
  echo "Unexpected workflow phase file count: $phaseCount, expected ${#phases[@]}"
  fail=1
fi

for phase in "${phases[@]}"; do
  if ! rg -q "$phase" .systems/ai/core/workflow.md; then
    echo "Phase missing from router: $phase"
    fail=1
  fi

  template=".systems/ai/templates/workflow/${phase%.md}.template.md"
  if [[ ! -f "$template" ]]; then
    echo "Phase template missing for $phase: $template"
    fail=1
  fi
done

for required_init_ref in AGENTS.md README.md HUMANS.md .systems/ai/core/installation.md .systems/ai/core/workflow.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md; do
  if ! rg -q 'phase-0-init|phase 0 init' "$required_init_ref"; then
    echo "Missing phase-0-init reference in $required_init_ref"
    fail=1
  fi
done

for required_init_text in 'legacy-index.md' 'blocked-owner-merge' 'ready-for-repo-intake' 'context/data only' 'phase-0-repo-intake'; do
  if ! rg -q "$required_init_text" .systems/ai/workflow/phase-0-init.md .systems/ai/templates/workflow/phase-0-init.template.md .systems/scripts/init-workspace .systems/ai/core/installation.md .systems/ai/core/command-routing.md; then
    echo "Missing phase-0-init bootstrap text: $required_init_text"
    fail=1
  fi
done

root_agents_template=".systems/ai/templates/root-agents.template.md"
for required_root_ref in 'ai-workflow/AGENTS.md' 'AI_WORKFLOW_HOME' 'AI_WORKFLOW_WORKSPACE_HOME' 'TARGET_REPO_ROOT' 'cd ai-workflow'; do
  if ! rg -q "$required_root_ref" "$root_agents_template"; then
    echo "Root AGENTS template missing required nested-clone ref: $required_root_ref"
    fail=1
  fi
done

workspace_phase=".systems/ai/workflow/phase-0-project-workspace.md"
workspace_template=".systems/ai/templates/workflow/phase-0-project-workspace.template.md"
for required_workspace_ref in 'tasks/' 'micro-tasks.md' 'micro-tasks/' 'change-requests.md' 'change-requests/' 'reviews/' 'autopilot/README.md' 'autopilot/runs/'; do
  if ! rg -q "$required_workspace_ref" "$workspace_phase"; then
    echo "Project workspace phase missing required workspace ref: $required_workspace_ref"
    fail=1
  fi

  if ! rg -q "$required_workspace_ref" "$workspace_template"; then
    echo "Project workspace template missing required workspace ref: $required_workspace_ref"
    fail=1
  fi
done

for required_change_ref in '.systems/ai/core/change-requests.md' 'change request' 'final-owner-yes'; do
  if ! rg -q "$required_change_ref" .systems/ai/workflow/phase-8-final-check.md; then
    echo "Final check missing change request ref: $required_change_ref"
    fail=1
  fi

  if ! rg -q "$required_change_ref" .systems/ai/core/command-routing.md; then
    echo "Command routing missing change request ref: $required_change_ref"
    fail=1
  fi
done

response_contract=".systems/ai/core/response-contract.md"
for required_response_contract_text in 'Co dalej?' 'Rekomendacja:' 'Alternatywa:' 'Napisz:' 'Recommendation Sources' 'Alternative Selection'; do
  if ! rg -q "$required_response_contract_text" "$response_contract"; then
    echo "Response contract missing required text: $required_response_contract_text"
    fail=1
  fi
done

for required_response_contract_ref in AGENTS.md .systems/ai/core/operating-model.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md .systems/ai/core/workflow.md; do
  if ! rg -q '.systems/ai/core/response-contract.md' "$required_response_contract_ref"; then
    echo "Missing response contract reference in $required_response_contract_ref"
    fail=1
  fi
done

for required_task_intake_ref in AGENTS.md .systems/ai/core/command-routing.md .systems/ai/core/operating-model.md .systems/ai/core/response-contract.md .systems/ai/core/workflow.md; do
  if ! rg -q '.systems/ai/core/task-intake.md' "$required_task_intake_ref"; then
    echo "Missing task intake reference in $required_task_intake_ref"
    fail=1
  fi
done

for required_task_intake_text in 'Co zostaje' 'Co jest słabe / do poprawy lub usunięcia' 'Czego brakuje' 'Blokery / decyzje' 'Rekomendowany routing'; do
  if ! rg -q "$required_task_intake_text" .systems/ai/core/task-intake.md .systems/ai/core/command-routing.md .systems/ai/core/response-contract.md; then
    echo "Missing task intake validation text: $required_task_intake_text"
    fail=1
  fi
done

parallel_policy=".systems/ai/core/parallel-work-policy.md"
if [[ ! -f "$parallel_policy" ]]; then
  echo "Missing parallel work policy: $parallel_policy"
  fail=1
fi

for required_parallel_ref in AGENTS.md HUMANS.md .systems/ai/core/operating-model.md .systems/ai/core/workflow.md .systems/ai/core/guide.md .systems/ai/core/command-routing.md; do
  if ! rg -q 'parallel-work-policy.md' "$required_parallel_ref"; then
    echo "Missing parallel work policy reference in $required_parallel_ref"
    fail=1
  fi
done

for required_parallel_text in 'status-only' 'write set' 'repo focus snapshot' 'Project status' 'memory router'; do
  if ! rg -qi "$required_parallel_text" "$parallel_policy"; then
    echo "Parallel work policy missing required text: $required_parallel_text"
    fail=1
  fi
done

