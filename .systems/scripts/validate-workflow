if [[ "$profile" == "full" && "${AI_WORKFLOW_SKIP_SMOKE_TESTS:-0}" != "1" ]]; then
  current_stage="smoke-suite"
  run_cmd .systems/scripts/check-validator-smoke-tests
fi

exit "$fail"
