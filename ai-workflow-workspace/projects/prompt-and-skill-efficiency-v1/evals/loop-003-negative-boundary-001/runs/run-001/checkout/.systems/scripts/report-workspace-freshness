#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$script_dir/resolve-workflow-env"
repo_root="$AI_WORKFLOW_HOME"
workspace_home="$AI_WORKFLOW_WORKSPACE_HOME"
output=""

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --output)
      [[ "$#" -ge 2 ]] || { echo "Missing --output value"; exit 1; }
      output="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: report-workspace-freshness --output <path>"
      exit 0
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

[[ -n "$output" ]] || { echo "--output is required"; exit 1; }
mkdir -p "$(dirname "$output")"
cd "$repo_root"

observed_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
repo_path="$(pwd -P)"
branch="$(git symbolic-ref --short -q HEAD || echo detached)"
head="$(git rev-parse HEAD)"
upstream="$(git rev-parse --verify '@{upstream}' 2>/dev/null || echo none)"
worktree_header="$(git status --short --branch | sed -n '1p')"
dirty_entries="$(git status --short | wc -l | tr -d ' ')"
worktree="$worktree_header"
if [[ "$dirty_entries" -gt 0 ]]; then
  worktree="$worktree_header + dirty ($dirty_entries entries)"
fi
recorded_status="$(rg -m1 -o 'updated-at[^|]*\| `[^`]+`|HEAD[^|]*\| `[^`]+`' "$workspace_home/repo/core/status.md" "$workspace_home/repo/core/repo-intake.md" 2>/dev/null | tr '\n' '; ' || true)"
recorded_intake="$(rg -m1 -o 'repo-path[^|]*\| `[^`]+`' "$workspace_home/repo/core/repo-intake.md" 2>/dev/null || true)"

drift="current"
if [[ "$branch" == detached || "$upstream" == none ]]; then
  drift="unknown"
fi
if [[ ! "$worktree_header" =~ ^##.*\.\.\. ]]; then
  drift="stale"
fi
if [[ "$dirty_entries" -gt 0 ]]; then
  drift="stale"
fi
if [[ -n "$recorded_intake" && "$recorded_intake" != *"$repo_path"* ]]; then
  drift="stale"
fi

cat > "$output" <<EOF
# Workspace Freshness Ledger

## Metadata

| Field | Value |
| --- | --- |
| Observed-at | \`$observed_at\` |
| Repository path | \`$repo_path\` |
| Branch | \`$branch\` |
| HEAD | \`$head\` |
| Upstream HEAD | \`$upstream\` |
| Worktree state | \`$worktree\` |

## Baseline Comparison

- Recorded status/intake baseline: \`$recorded_status\`
- Recorded intake path: \`$recorded_intake\`
- Drift: \`$drift\`
- Recommended action: \`refresh ignored repo runtime before relying on it\`
- Evidence scope: repository metadata only; no repository contents, secrets, or client data copied.
- Advisory-only: \`yes\`

EOF

echo "Workspace freshness report written: $output"
