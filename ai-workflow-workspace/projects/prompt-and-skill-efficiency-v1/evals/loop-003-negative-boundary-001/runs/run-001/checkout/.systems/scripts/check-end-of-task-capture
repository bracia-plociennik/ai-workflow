#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/policy-boundaries.sh"

fail=0

require_ref() {
  local file="$1"
  local pattern="$2"
  local label="$3"

  if [[ ! -f "$file" ]]; then
    echo "Missing file for end-of-task capture check: $file"
    fail=1
    return 0
  fi

  if ! rg -qi "$pattern" "$file"; then
    echo "Missing end-of-task capture reference in $file: $label"
    fail=1
  fi
}

contract=".systems/ai/core/end-of-task-capture.md"
template=".systems/ai/templates/capture/end-of-task-capture.template.md"

require_ref "$contract" '^# end-of-task-capture\.md$' "core contract"
require_ref "$contract" 'End-of-Task Capture' "contract name"
require_ref "$contract" 'Trigger Grammar' "trigger grammar"
require_ref "$contract" 'Precedence Rules' "precedence rules"
require_ref "$contract" 'Required Output' "required output"
require_ref "$contract" 'Safety Boundaries' "safety boundaries"
require_ref "$template" '^# End-of-Task Capture$' "template"

for trigger in \
  'Koniec pracy' \
  'Koniec zadania' \
  'to koniec zadania' \
  'koniec taska' \
  'kończymy ten task' \
  'dziękuję, utrwal wiedzę' \
  'utrwal wiedzę z tej rozmowy' \
  'end task and capture knowledge' \
  'done, capture learnings'
do
  require_ref "$contract" "$trigger" "trigger: $trigger"
  require_ref ".systems/ai/core/command-routing.md" "$trigger" "routing trigger: $trigger"
done

for field in \
  'Trigger detected' \
  'Matched route' \
  'Precedence check' \
  'Work mode' \
  'Source scope reviewed' \
  'Completion state' \
  'Capture targets' \
  'Capture mode' \
  'Writes allowed' \
  'Owner approval' \
  'Privacy/scope check' \
  'Distillation needed' \
  'Checkpoint needed' \
  'Memory/status updates' \
  'System Insight candidates' \
  'External Memory candidates' \
  'Skipped capture' \
  'Residual risk'
do
  require_ref "$contract" "$field" "output field: $field"
  require_ref "$template" "$field" "template field: $field"
done

for route in \
  'final-owner-yes' \
  'pre-final change requests' \
  'post-final change requests' \
  'phase-6-distillation' \
  'phase-7-checkpoint' \
  'phase-8-final-check' \
  'phase-5-quality' \
  'final review' \
  'code review' \
  'find blockers' \
  'find findings' \
  'Commit readiness' \
  'End-of-Task Capture'
do
  require_ref "$contract" "$route" "precedence route: $route"
done

for unchanged in \
  'Zrób distillation.*phase-6-distillation' \
  'Run phase 6.*phase-6-distillation' \
  'Zrób checkpoint.*phase-7-checkpoint' \
  'Run checkpoint.*phase-7-checkpoint' \
  'Zrób final check.*phase-8-final-check' \
  'Zrób final review.*global-quality-review-stance'
do
  require_ref "$contract" "$unchanged" "unchanged route: $unchanged"
  require_ref ".systems/ai/core/command-routing.md" "$unchanged" "routing unchanged: $unchanged"
done

for boundary in \
  'mark `PASS` automatically' \
  'run `phase-8-final-check` automatically' \
  'close a project without `final-owner-yes`' \
  'update status from chat-only claims' \
  'write raw client data' \
  'write frontend, backend, SEO, ads, smart-contract, product, or client-work lessons into External Memory'
do
  require_ref "$contract" "$boundary" "safety boundary: $boundary"
done

for integration in \
  "AGENTS.md:end-of-task-capture\\.md" \
  "HUMANS.md:End-of-Task Capture" \
  "README.md:end-of-task-capture\\.md" \
  ".systems/ai/core/workflow.md:end-of-task-capture\\.md" \
  ".systems/ai/core/memory.md:Koniec pracy.*Koniec zadania.*capture-now" \
  ".systems/ai/core/contract-compliance.md:end-of-task-capture\\.md" \
  ".systems/ai/core/definition-of-done.md:end-of-task-capture\\.md" \
  ".systems/ai/core/response-contract.md:end-of-task-capture\\.md" \
  ".systems/ai/core/commands.md:check-end-of-task-capture" \
  "README.md:check-end-of-task-capture" \
  "AGENTS.md:check-end-of-task-capture" \
  ".systems/scripts/validate-workflow:check-end-of-task-capture" \
  ".systems/scripts/check-required-artifacts:check-end-of-task-capture" \
  ".systems/scripts/check-validator-smoke-tests:end-of-task-capture"
do
  file="${integration%%:*}"
  pattern="${integration#*:}"
  require_ref "$file" "$pattern" "integration: $pattern"
done

unsafe_patterns=(
  '(Koniec pracy|Koniec zadania)[^.\n]{0,120}\b(may|can|should|will)\b[^.\n]{0,100}\b(acknowledge only|ask what to do next|proposal-only)\b'
  '(Koniec pracy|Koniec zadania)[^.\n]{0,120}\bdoes not require\b[^.\n]{0,80}\bcapture\b'
  'end task may mark PASS automatically'
  'end task runs phase-8-final-check'
  'end task may close project without final-owner-yes'
  'System Insights may include client names'
  'External Memory stores frontend lessons'
  '(End-of-Task Capture|end task|koniec zadania|utrwal wiedzę)[^.\n]{0,120}\b(may|can|will|should|automatically|allows?)\b[^.\n]{0,120}\b(mark PASS|PASS|run phase-8-final-check|final check|close project|final-owner-yes|update status from chat-only|client names|raw client data|External Memory stores frontend)\b'
  '\b(Zrób distillation|Run phase 6)\b[^.\n]{0,120}\b(End-of-Task Capture|end-of-task)\b'
  '\b(Zrób checkpoint|Run checkpoint)\b[^.\n]{0,120}\b(End-of-Task Capture|end-of-task)\b'
  '\bfinal review\b[^.\n]{0,120}\b(phase-8-final-check|final check)\b'
)

for pattern in "${unsafe_patterns[@]}"; do
  policy_reject_unsafe_pattern "$pattern" "Unsafe end-of-task capture wording found: $pattern" \
    AGENTS.md HUMANS.md README.md .systems/ai/core .systems/ai/workflow .systems/ai/templates
done

exit "$fail"
