#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/policy-boundaries.sh"

fail=0

require_ref() {
  local file="$1"
  local pattern="$2"
  local label="$3"

  if [[ ! -f "$file" ]]; then
    echo "Missing file for response evidence trace check: $file"
    fail=1
    return 0
  fi

  if ! rg -q "$pattern" "$file"; then
    echo "Missing response evidence trace reference in $file: $label"
    fail=1
  fi
}

require_literal() {
  local file="$1"
  local value="$2"
  local label="$3"

  if [[ ! -f "$file" ]]; then
    echo "Missing file for response evidence trace check: $file"
    fail=1
    return 0
  fi

  if ! rg -qF -- "$value" "$file"; then
    echo "Missing response evidence trace reference in $file: $label"
    fail=1
  fi
}

contract=".systems/ai/core/response-contract.md"

require_ref "$contract" '^## Execution Trace$' "Execution Trace section"
require_ref "$contract" 'Every substantive response must include an `Execution Trace` block immediately before the final `Co dalej\?` footer' "trace before footer"
require_ref "$contract" '`Co dalej\?` must remain the final human-facing section' "Co dalej final footer"

for field in \
  'Sources used:' \
  'Evidence reviewed:' \
  'Workflow procedures used:' \
  'Skills/roles used:' \
  'Commands/checks run:' \
  'Skipped/unreadable sources:' \
  'Limits/residual uncertainty:'
do
  require_ref "$contract" "$field" "trace field: $field"
done

for field in \
  'Instruction refresh:' \
  'Status: <performed-targeted|performed-full|not-needed|blocked>' \
  'Trigger: <trigger|none>' \
  'Contracts refreshed: <paths|not-needed>' \
  'Reviewed baseline: <HEAD/worktree/status/artifacts|not-needed>' \
  'Drift/conflict: <none|warning|blocked>'
do
  require_literal "$contract" "$field" "trace field: $field"
done

for field in \
  'Owner decision interaction:' \
  '- Mode: <asked|queued|none-needed|skipped-owner-opt-out|autopilot-non-interactive>' \
  '- Decisions asked/pending: <ids|none>' \
  '- Auto-resolved decisions: <ids|none>'
do
  require_literal "$contract" "$field" "owner decision trace field: $field"
done

require_ref "AGENTS.md" 'Execution Trace' "AGENTS execution trace"
require_ref "AGENTS.md" 'refresh status, trigger, refreshed contracts, reviewed baseline, and drift/conflict' "AGENTS instruction refresh trace"
require_ref "HUMANS.md" 'Execution Trace' "human guidance"
require_ref "README.md" 'check-response-evidence-trace' "README validator list"
require_ref ".systems/ai/core/commands.md" 'check-response-evidence-trace' "commands validator list"
require_ref ".systems/scripts/validate-workflow" 'check-response-evidence-trace' "validate-workflow chain"
require_ref ".systems/scripts/check-required-artifacts" 'check-response-evidence-trace' "required artifacts"
require_ref ".systems/scripts/check-validator-smoke-tests" 'response-evidence-trace' "smoke coverage"

policy_reject_unsafe_pattern \
  'no sources needed|sources are optional|Execution Trace may be omitted for substantive responses|Execution Trace[^.\n]{0,80}(after|following|later than)[^.\n]{0,80}Co dalej\?' \
  "Unsafe response evidence trace wording found" \
  AGENTS.md HUMANS.md README.md .systems/ai/core .systems/ai/workflow .systems/ai/templates

exit "$fail"
