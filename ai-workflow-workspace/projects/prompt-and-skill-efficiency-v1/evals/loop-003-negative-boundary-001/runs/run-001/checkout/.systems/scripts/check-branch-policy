#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/../.." && pwd -P)"
cd "$repo_root"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

policy="${AI_WORKFLOW_BRANCH_POLICY:-auto}"

resolve_auto_policy() {
  local branch=""

  if [[ -n "${GITHUB_BASE_REF:-}" ]]; then
    branch="$GITHUB_BASE_REF"
  elif [[ -n "${GITHUB_REF_NAME:-}" ]]; then
    branch="$GITHUB_REF_NAME"
  else
    branch="$(git branch --show-current 2>/dev/null || true)"
  fi

  case "$branch" in
    main|"")
      printf 'public\n'
      ;;
    *)
      printf 'public\n'
      ;;
  esac
}

case "$policy" in
  auto)
    policy="$(resolve_auto_policy)"
    ;;
  public|dev)
    ;;
  *)
    echo "Invalid AI_WORKFLOW_BRANCH_POLICY: $policy"
    echo "Allowed values: auto, public, dev"
    echo "Note: dev is a compatibility alias and does not allow tracked runtime workspace files."
    exit 1
    ;;
esac

tracked_legacy="$(git ls-files -- workspace || true)"
tracked_local_workspace="$(git ls-files -- ai-workflow-workspace || true)"
fail=0

if [[ -n "$tracked_legacy" ]]; then
  echo "Branch policy violation: legacy workspace files are tracked under workspace/."
  echo "Runtime workspace must stay local-only and untracked."
  printf '%s\n' "$tracked_legacy" | sed 's/^/ - /'
  fail=1
fi

if [[ -n "$tracked_local_workspace" ]]; then
  echo "Branch policy violation: ai-workflow-workspace/ is tracked."
  echo "ai-workflow-workspace/ must remain local-only and ignored in this repository."
  printf '%s\n' "$tracked_local_workspace" | sed 's/^/ - /'
  fail=1
fi

exit "$fail"
