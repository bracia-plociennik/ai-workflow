# Codex project configuration template.
# Copy to `.codex/config.toml` only when the target repository wants project-scoped Codex defaults.

model = "gpt-5.4"
model_reasoning_effort = "medium"

approval_policy = "on-request"
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = false
writable_roots = []

[profiles.safe]
approval_policy = "on-request"
sandbox_mode = "workspace-write"
model_reasoning_effort = "medium"

[profiles.readonly]
approval_policy = "untrusted"
sandbox_mode = "read-only"
model_reasoning_effort = "low"

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[features]
web_search = false

# Repository-specific overrides belong in the target repository, not in this template.
