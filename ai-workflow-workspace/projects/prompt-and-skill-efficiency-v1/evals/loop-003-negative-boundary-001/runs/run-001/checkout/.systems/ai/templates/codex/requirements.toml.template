# Codex tool requirements template.
# Use this as a human-readable checklist for target repositories.

[runtime]
codex_cli = "required"
git = "required"
ripgrep = "required"

[commands]
install = "define in workspace/repo/core/repo-intake.md"
lint = "define in workspace/repo/core/repo-intake.md"
typecheck = "define in workspace/repo/core/repo-intake.md"
test = "define in workspace/repo/core/repo-intake.md"
build = "define in workspace/repo/core/repo-intake.md"

[safety]
network_access = "disabled by default"
production_writes = "forbidden without explicit owner approval"
secrets_access = "forbidden without explicit audit request"
destructive_commands = "forbidden without explicit owner approval"
