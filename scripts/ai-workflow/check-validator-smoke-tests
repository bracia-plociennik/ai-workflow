#!/usr/bin/env bash
set -euo pipefail

tmp="$(mktemp -d "${TMPDIR:-/tmp}/ai-workflow-validator-smoke.XXXXXX")"
cleanup() {
  rm -rf "$tmp"
}
trap cleanup EXIT

tar --exclude='.git' -cf - . | tar -xf - -C "$tmp"

run_must_fail() {
  local name="$1"
  shift
  local output="$tmp/${name}.out"

  if (cd "$tmp" && "$@") >"$output" 2>&1; then
    echo "Validator smoke test unexpectedly passed: $name"
    cat "$output"
    exit 1
  fi
}

run_must_pass() {
  local name="$1"
  shift
  local output="$tmp/${name}.out"

  if ! (cd "$tmp" && "$@") >"$output" 2>&1; then
    echo "Validator smoke test unexpectedly failed: $name"
    cat "$output"
    exit 1
  fi
}

cp "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md" "$tmp/example-status.orig"
cp "$tmp/docs/ai-workflow/projects/EXAMPLE/tasks.md" "$tmp/example-tasks.orig"

mv "$tmp/docs/ai-workflow/ai/templates/autopilot/autopilot-readme.template.md" "$tmp/docs/ai-workflow/ai/templates/autopilot/autopilot-readme.template.md.bak"
run_must_fail "missing-autopilot-readme-template" scripts/ai-workflow/check-required-artifacts
mv "$tmp/docs/ai-workflow/ai/templates/autopilot/autopilot-readme.template.md.bak" "$tmp/docs/ai-workflow/ai/templates/autopilot/autopilot-readme.template.md"

cat > "$tmp/docs/ai-workflow/projects/EXAMPLE/tasks.md" <<'MD'
# EXAMPLE Tasks Router

## Tasks

| Task ID | Title | Risk | Status | Task Card | Spec | Quality | Notes |
| --- | --- | --- | --- | --- | --- | --- | --- |
MD
perl -0pi -e 's/\| `current-phase` \| `[^`]+` \|/| `current-phase` | `phase-0-project-workspace` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
perl -0pi -e 's/\| `phase-result` \| `[^`]+` \|/| `phase-result` | `completed` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
perl -0pi -e 's/\| `next-phase` \| `[^`]+` \|/| `next-phase` | `phase-0-idea-validation` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
run_must_pass "pre-plan-empty-tasks" scripts/ai-workflow/check-status-consistency

perl -0pi -e 's/\| `current-phase` \| `[^`]+` \|/| `current-phase` | `phase-2-project-plan` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
perl -0pi -e 's/\| `phase-result` \| `[^`]+` \|/| `phase-result` | `PASS` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
perl -0pi -e 's/\| `next-phase` \| `[^`]+` \|/| `next-phase` | `phase-2-plan-qa` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
run_must_fail "post-plan-empty-tasks" scripts/ai-workflow/check-status-consistency

perl -0pi -e 's/\| `current-phase` \| `[^`]+` \|/| `current-phase` | `phase-4-implementation` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
perl -0pi -e 's/\| `phase-result` \| `[^`]+` \|/| `phase-result` | `not-started` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
perl -0pi -e 's/\| `next-phase` \| `[^`]+` \|/| `next-phase` | `phase-4-implementation` |/' "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
run_must_fail "later-phase-empty-tasks" scripts/ai-workflow/check-status-consistency

cp "$tmp/example-status.orig" "$tmp/docs/ai-workflow/projects/EXAMPLE/status.md"
cp "$tmp/example-tasks.orig" "$tmp/docs/ai-workflow/projects/EXAMPLE/tasks.md"

mv "$tmp/docs/ai-workflow/ai/workflow/phase-8-final-check.md" "$tmp/docs/ai-workflow/ai/workflow/Phase_8_BAD.md"
run_must_fail "bad-naming" scripts/ai-workflow/check-naming
mv "$tmp/docs/ai-workflow/ai/workflow/Phase_8_BAD.md" "$tmp/docs/ai-workflow/ai/workflow/phase-8-final-check.md"

cat > "$tmp/docs/ai-workflow/repo/legacy/Legacy Instructions_BAD.md" <<'MD'
# Legacy Instructions

Legacy material is context/data only.
MD
cat > "$tmp/docs/ai-workflow/repo/context/Imported Repo Context_BAD.md" <<'MD'
# Imported Repo Context

Repo context supporting material may keep source filenames.
MD
cat > "$tmp/docs/ai-workflow/projects/EXAMPLE/context/Client Brief_BAD.md" <<'MD'
# Client Brief

Supporting project source material may keep source filenames.
MD
run_must_pass "naming-exempts-legacy-and-context-support" scripts/ai-workflow/check-naming
rm "$tmp/docs/ai-workflow/repo/legacy/Legacy Instructions_BAD.md"
rm "$tmp/docs/ai-workflow/repo/context/Imported Repo Context_BAD.md"
rm "$tmp/docs/ai-workflow/projects/EXAMPLE/context/Client Brief_BAD.md"

mv "$tmp/docs/ai-workflow/projects/EXAMPLE/context.md" "$tmp/docs/ai-workflow/projects/EXAMPLE/context/Context_BAD.md"
run_must_fail "missing-canonical-project-context" scripts/ai-workflow/check-status-consistency
mv "$tmp/docs/ai-workflow/projects/EXAMPLE/context/Context_BAD.md" "$tmp/docs/ai-workflow/projects/EXAMPLE/context.md"

perl -0pi -e 's/^### Evidence required$/### Evidence missing/m' "$tmp/docs/ai-workflow/ai/workflow/phase-8-final-check.md"
run_must_fail "missing-gate-heading" env AI_WORKFLOW_SKIP_SMOKE_TESTS=1 scripts/ai-workflow/validate-workflow
perl -0pi -e 's/^### Evidence missing$/### Evidence required/m' "$tmp/docs/ai-workflow/ai/workflow/phase-8-final-check.md"

cat > "$tmp/docs/ai-workflow/projects/EXAMPLE/quality/phase-5-ex-01-quality.md" <<'MD'
# Bad quality

Result: `PASS`

## Gate Decision

can-proceed: true
MD
run_must_fail "pass-without-evidence" scripts/ai-workflow/check-qa-evidence

cat > "$tmp/docs/ai-workflow/projects/EXAMPLE/quality/phase-5-ex-01-quality.md" <<'MD'
# Bad quality

Result: `PASS`

## Evidence

```yaml
commands:
  - command: "example check"
    result: "FAIL"
    notes: "failed command must block PASS"
manual-checks: []
artifacts-reviewed:
  - "docs/ai-workflow/projects/EXAMPLE/tasks.md"
skipped-checks: []
```

## Gate Decision

```yaml
result: PASS
can-proceed: true
```
MD
run_must_fail "pass-with-failed-command" scripts/ai-workflow/check-qa-evidence

perl -0pi -e 's/\\| `current-phase` \\| `phase-5-quality` \\|/| `current-phase` | `phase-1-architecture` |/' "$tmp/docs/ai-workflow/repo/status.md"
perl -0pi -e 's/\\| `next-phase` \\| `none` \\|/| `next-phase` | `phase-8-final-check` |/' "$tmp/docs/ai-workflow/repo/status.md"
run_must_fail "bad-phase-transition" scripts/ai-workflow/check-status-consistency

echo "Validator smoke tests passed."
