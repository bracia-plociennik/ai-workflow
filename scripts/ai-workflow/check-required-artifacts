fail=0

for path in "${required[@]}"; do
  if [[ ! -f "$path" ]]; then
    echo "Missing required artifact: $path"
    fail=1
  fi
done

for phase in "${phases[@]}"; do
  if [[ ! -f "docs/ai-workflow/ai/workflow/$phase" ]]; then
    echo "Missing workflow phase: docs/ai-workflow/ai/workflow/$phase"
    fail=1
  fi

  template="docs/ai-workflow/ai/templates/workflow/${phase%.md}.template.md"
  if [[ ! -f "$template" ]]; then
    echo "Missing workflow template: $template"
    fail=1
  fi
done

exit "$fail"
