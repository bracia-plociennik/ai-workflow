#!/usr/bin/env bash
set -euo pipefail

fail=0

has_pass_result() {
  local file="$1"
  rg -q '(^|[:|` ])PASS([` |]|$)' "$file"
}

section_after() {
  local heading="$1"
  local file="$2"
  awk -v heading="$heading" '
    $0 == heading {in_section=1; next}
    in_section && /^## / {exit}
    in_section {print}
  ' "$file"
}

reject_pass_file() {
  local file="$1"
  local reason="$2"
  echo "Invalid PASS evidence in ${file#./}: $reason"
  fail=1
}

while IFS= read -r -d '' file; do
  if has_pass_result "$file"; then
    if ! rg -q '^## Evidence$' "$file"; then
      reject_pass_file "$file" "missing ## Evidence section"
    fi

    if ! rg -q '^## Gate Decision$' "$file"; then
      reject_pass_file "$file" "missing ## Gate Decision section"
    fi

    evidence="$(section_after "## Evidence" "$file")"
    gate="$(section_after "## Gate Decision" "$file")"

    if [[ -z "${evidence//[[:space:]]/}" ]]; then
      reject_pass_file "$file" "empty Evidence section"
    fi

    if rg -qi '(<[^>]+>|null|todo|tbd|no evidence|without evidence|not-run|not run)' "$file"; then
      reject_pass_file "$file" "contains placeholder, missing evidence marker, or not-run marker"
    fi

    if rg -qi 'affects[ -]?pass[?: ]*(true|yes)' "$file"; then
      reject_pass_file "$file" "contains skipped check that affects PASS"
    fi

    if printf '%s\n%s\n' "$evidence" "$gate" | rg -qi 'result:[[:space:]]*"?FAIL"?|(^|\|)[[:space:]]*FAIL[[:space:]]*(\||$)|can-proceed:[[:space:]]*false'; then
      reject_pass_file "$file" "contains failed evidence or gate decision while artifact result is PASS"
    fi

    if ! printf '%s\n' "$evidence" | rg -qi '(command:|manual-checks:|artifacts-reviewed:|^\| .+ \| .+PASS.+ \| .+ \|)'; then
      reject_pass_file "$file" "Evidence section has no command, manual check, reviewed artifact, or PASS evidence row"
    fi

    if ! printf '%s\n' "$gate" | rg -qi '(can-proceed: true|can proceed.*yes|result: PASS|quality result: PASS|qa result: PASS)'; then
      reject_pass_file "$file" "Gate Decision does not explicitly allow proceeding"
    fi
  fi
done < <(find docs/ai-workflow/projects -path '*/quality/*' -type f -name '*.md' -print0 2>/dev/null || true)

exit "$fail"
