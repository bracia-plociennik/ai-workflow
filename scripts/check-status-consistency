#!/usr/bin/env bash
set -euo pipefail

fail=0
status="docs/repo/core/status.md"

phases=(
  phase-0-repo-intake
  phase-0-project-workspace
  phase-0-idea-validation
  phase-1-architecture
  phase-1-architecture-qa
  phase-1-architecture-fix-loop
  phase-2-project-plan
  phase-2-plan-qa
  phase-2-plan-fix-loop
  phase-2-task-packaging
  phase-2-packaging-qa
  phase-2-package-fix-loop
  phase-3-specification
  phase-3-spec-qa
  phase-3-spec-fix-loop
  phase-4-implementation
  phase-5-quality
  phase-5-fix-loop
  phase-6-distillation
  phase-7-checkpoint
  phase-8-final-check
)

phase_set_pattern="$(IFS='|'; echo "${phases[*]}")"

value_for() {
  local key="$1"
  local file="$2"
  awk -F '|' -v key="$key" '
    $2 ~ "`" key "`" {
      value=$3
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/`/, "", value)
      print value
      exit
    }
  ' "$file"
}

require_key() {
  local key="$1"
  local file="$2"
  if ! rg -q "\\\`$key\\\`" "$file"; then
    echo "${file#./} missing status key: $key"
    fail=1
  fi
}

validate_phase_value() {
  local field="$1"
  local value="$2"
  local file="$3"
  [[ -z "$value" ]] && return 0

  if [[ ! "$value" =~ ^($phase_set_pattern|none|not-applicable|owner-final-approval)$ ]]; then
    echo "${file#./} has invalid $field: $value"
    fail=1
  fi
}

validate_result_value() {
  local value="$1"
  local file="$2"
  [[ -z "$value" ]] && return 0

  if [[ ! "$value" =~ ^(not-started|in-progress|PASS|FAIL|completed|blocked|skipped|awaiting-owner-final-yes|none|example-only)$ ]]; then
    echo "${file#./} has invalid phase-result: $value"
    fail=1
  fi
}

is_allowed_transition() {
  local current_phase="$1"
  local phase_result="$2"
  local next_phase="$3"
  local workflow_scope="$4"

  [[ -z "$current_phase" || -z "$next_phase" ]] && return 0
  [[ "$current_phase" == "none" || "$current_phase" == "not-applicable" ]] && return 0
  [[ "$next_phase" == "not-applicable" ]] && return 0

  if [[ "$workflow_scope" == "template-maintenance" && "$phase_result" =~ ^(PASS|completed)$ && "$next_phase" == "none" ]]; then
    return 0
  fi

  case "$phase_result" in
    not-started|in-progress|blocked|none|example-only)
      [[ "$next_phase" == "$current_phase" || "$next_phase" == "none" ]]
      return
      ;;
  esac

  case "$current_phase:$phase_result:$next_phase" in
    phase-0-idea-validation:PASS:phase-0-repo-intake|\
    phase-0-idea-validation:completed:phase-0-repo-intake|\
    phase-0-idea-validation:blocked:none|\
    phase-0-project-workspace:PASS:phase-0-idea-validation|\
    phase-0-project-workspace:completed:phase-0-idea-validation|\
    phase-0-project-workspace:PASS:phase-0-repo-intake|\
    phase-0-project-workspace:completed:phase-0-repo-intake|\
    phase-0-project-workspace:blocked:none|\
    phase-0-repo-intake:PASS:phase-0-project-workspace|\
    phase-0-repo-intake:completed:phase-0-project-workspace|\
    phase-0-repo-intake:PASS:phase-1-architecture|\
    phase-0-repo-intake:completed:phase-1-architecture|\
    phase-0-repo-intake:blocked:none|\
    phase-1-architecture:PASS:phase-1-architecture-qa|\
    phase-1-architecture:completed:phase-1-architecture-qa|\
    phase-1-architecture-qa:PASS:phase-2-project-plan|\
    phase-1-architecture-qa:FAIL:phase-1-architecture-fix-loop|\
    phase-1-architecture-fix-loop:completed:phase-1-architecture-qa|\
    phase-1-architecture-fix-loop:PASS:phase-1-architecture-qa|\
    phase-2-project-plan:PASS:phase-2-plan-qa|\
    phase-2-project-plan:completed:phase-2-plan-qa|\
    phase-2-plan-qa:PASS:phase-2-task-packaging|\
    phase-2-plan-qa:FAIL:phase-2-plan-fix-loop|\
    phase-2-plan-fix-loop:completed:phase-2-plan-qa|\
    phase-2-plan-fix-loop:PASS:phase-2-plan-qa|\
    phase-2-task-packaging:PASS:phase-2-packaging-qa|\
    phase-2-task-packaging:completed:phase-2-packaging-qa|\
    phase-2-task-packaging:PASS:phase-3-specification|\
    phase-2-task-packaging:completed:phase-3-specification|\
    phase-2-packaging-qa:PASS:phase-3-specification|\
    phase-2-packaging-qa:skipped:phase-3-specification|\
    phase-2-packaging-qa:FAIL:phase-2-package-fix-loop|\
    phase-2-package-fix-loop:completed:phase-2-packaging-qa|\
    phase-2-package-fix-loop:PASS:phase-2-packaging-qa|\
    phase-3-specification:PASS:phase-3-spec-qa|\
    phase-3-specification:completed:phase-3-spec-qa|\
    phase-3-spec-qa:PASS:phase-4-implementation|\
    phase-3-spec-qa:FAIL:phase-3-spec-fix-loop|\
    phase-3-spec-fix-loop:completed:phase-3-spec-qa|\
    phase-3-spec-fix-loop:PASS:phase-3-spec-qa|\
    phase-4-implementation:completed:phase-5-quality|\
    phase-4-implementation:PASS:phase-5-quality|\
    phase-5-quality:PASS:phase-6-distillation|\
    phase-5-quality:FAIL:phase-5-fix-loop|\
    phase-5-fix-loop:completed:phase-5-quality|\
    phase-5-fix-loop:PASS:phase-5-quality|\
    phase-6-distillation:completed:phase-7-checkpoint|\
    phase-6-distillation:PASS:phase-7-checkpoint|\
    phase-6-distillation:completed:phase-3-specification|\
    phase-6-distillation:PASS:phase-3-specification|\
    phase-6-distillation:completed:phase-8-final-check|\
    phase-6-distillation:PASS:phase-8-final-check|\
    phase-7-checkpoint:completed:phase-3-specification|\
    phase-7-checkpoint:PASS:phase-3-specification|\
    phase-7-checkpoint:completed:phase-8-final-check|\
    phase-7-checkpoint:PASS:phase-8-final-check|\
    phase-7-checkpoint:FAIL:none|\
    phase-8-final-check:awaiting-owner-final-yes:owner-final-approval|\
    phase-8-final-check:FAIL:phase-1-architecture|\
    phase-8-final-check:FAIL:phase-1-architecture-fix-loop|\
    phase-8-final-check:FAIL:phase-2-project-plan|\
    phase-8-final-check:FAIL:phase-2-plan-fix-loop|\
    phase-8-final-check:FAIL:phase-3-specification|\
    phase-8-final-check:FAIL:phase-3-spec-fix-loop|\
    phase-8-final-check:FAIL:phase-4-implementation|\
    phase-8-final-check:FAIL:phase-5-quality|\
    phase-8-final-check:FAIL:phase-5-fix-loop|\
    phase-8-final-check:FAIL:none|\
    phase-8-final-check:PASS:owner-final-approval)
      return 0
      ;;
  esac

  return 1
}

validate_status_file() {
  local file="$1"

  for key in workflow-scope current-phase phase-result next-phase blocking-reason updated-at; do
    require_key "$key" "$file"
  done

  local current_phase phase_result next_phase blocking_reason
  local workflow_scope
  workflow_scope="$(value_for workflow-scope "$file")"
  current_phase="$(value_for current-phase "$file")"
  phase_result="$(value_for phase-result "$file")"
  next_phase="$(value_for next-phase "$file")"
  blocking_reason="$(value_for blocking-reason "$file")"

  validate_phase_value current-phase "$current_phase" "$file"
  validate_phase_value next-phase "$next_phase" "$file"
  validate_result_value "$phase_result" "$file"

  if [[ "$phase_result" == "blocked" && ( -z "$blocking_reason" || "$blocking_reason" == "none" ) ]]; then
    echo "${file#./} is blocked but blocking-reason is empty or none"
    fail=1
  fi

  if [[ "$phase_result" =~ ^(PASS|completed)$ && "$next_phase" == "none" && "$current_phase" != "phase-8-final-check" && "$workflow_scope" != "template-maintenance" ]]; then
    echo "${file#./} completed a non-final phase but next-phase is none"
    fail=1
  fi

  if ! is_allowed_transition "$current_phase" "$phase_result" "$next_phase" "$workflow_scope"; then
    echo "${file#./} has invalid phase transition: $current_phase + $phase_result -> $next_phase"
    fail=1
  fi
}

tasks_required_for_status() {
  local current_phase="$1"
  local phase_result="$2"

  if [[ "$current_phase" == "phase-2-project-plan" && "$phase_result" =~ ^(PASS|completed)$ ]]; then
    return 0
  fi

  case "$current_phase" in
    phase-2-plan-qa|\
    phase-2-plan-fix-loop|\
    phase-2-task-packaging|\
    phase-2-packaging-qa|\
    phase-2-package-fix-loop|\
    phase-3-specification|\
    phase-3-spec-qa|\
    phase-3-spec-fix-loop|\
    phase-4-implementation|\
    phase-5-quality|\
    phase-5-fix-loop|\
    phase-6-distillation|\
    phase-7-checkpoint|\
    phase-8-final-check)
      return 0
      ;;
  esac

  return 1
}

context_required_for_status() {
  local current_phase="$1"
  local phase_result="$2"

  if [[ "$current_phase" == "phase-0-repo-intake" && "$phase_result" =~ ^(PASS|completed)$ ]]; then
    return 0
  fi

  case "$current_phase" in
    phase-1-architecture|\
    phase-1-architecture-qa|\
    phase-1-architecture-fix-loop|\
    phase-2-project-plan|\
    phase-2-plan-qa|\
    phase-2-plan-fix-loop|\
    phase-2-task-packaging|\
    phase-2-packaging-qa|\
    phase-2-package-fix-loop|\
    phase-3-specification|\
    phase-3-spec-qa|\
    phase-3-spec-fix-loop|\
    phase-4-implementation|\
    phase-5-quality|\
    phase-5-fix-loop|\
    phase-6-distillation|\
    phase-7-checkpoint|\
    phase-8-final-check)
      return 0
      ;;
  esac

  return 1
}

validate_project_context() {
  local project_dir="$1"
  local current_phase="${2:-}"
  local phase_result="${3:-}"
  local context_file="$project_dir/context.md"

  if context_required_for_status "$current_phase" "$phase_result" && [[ ! -f "$context_file" ]]; then
    echo "${project_dir#./} is in or past project/context intake but missing canonical context: $context_file"
    fail=1
  fi
}

validate_tasks_file() {
  local file="$1"
  local current_phase="${2:-}"
  local phase_result="${3:-}"
  local saw_task=0

  while IFS= read -r line; do
    [[ "$line" == \|* ]] || continue
    [[ "$line" == *"Task ID"* || "$line" == *"---"* ]] && continue

    task_id="$(printf '%s\n' "$line" | awk -F '|' '{value=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); gsub(/`/, "", value); print value}')"
    status_value="$(printf '%s\n' "$line" | awk -F '|' '{value=$5; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); gsub(/`/, "", value); print value}')"
    task_card_path="$(printf '%s\n' "$line" | awk -F '|' '{value=$6; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); gsub(/`/, "", value); print value}')"
    spec_path="$(printf '%s\n' "$line" | awk -F '|' '{value=$7; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); gsub(/`/, "", value); print value}')"
    quality_path="$(printf '%s\n' "$line" | awk -F '|' '{value=$8; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); gsub(/`/, "", value); print value}')"

    [[ -z "$task_id" || "$task_id" == \<* ]] && continue
    saw_task=1

    if [[ ! "$task_id" =~ ^[A-Z][A-Z0-9]*-[A-Z][A-Z0-9]*-[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
      echo "${file#./} has invalid task ID: $task_id"
      fail=1
    fi

    if [[ ! "$status_value" =~ ^(ready|conditional|blocked|in-progress|done|deferred|example-only)$ ]]; then
      echo "${file#./} has invalid task status for $task_id: $status_value"
      fail=1
    fi

    for path in "$task_card_path" "$spec_path" "$quality_path"; do
      [[ -z "$path" || "$path" == "none" || "$path" == \<* ]] && continue
      if [[ ! -f "$path" ]]; then
        echo "${file#./} references missing task artifact for $task_id: $path"
        fail=1
      fi
    done
  done < "$file"

  if [[ "$saw_task" -eq 0 ]] && tasks_required_for_status "$current_phase" "$phase_result"; then
    echo "${file#./} has no concrete task rows"
    fail=1
  fi
}

if [[ ! -f "$status" ]]; then
  echo "Missing repo status: $status"
  exit 1
fi

validate_status_file "$status"
require_key active-project "$status"

activeProject="$(value_for active-project "$status")"

if [[ -n "${activeProject:-}" && "$activeProject" != "none" && "$activeProject" != "not-applicable" ]]; then
  if [[ ! -f "docs/projects/$activeProject/status.md" ]]; then
    echo "Active project status missing: docs/projects/$activeProject/status.md"
    fail=1
  else
    validate_status_file "docs/projects/$activeProject/status.md"
  fi

  if [[ ! -f "docs/projects/$activeProject/tasks.md" ]]; then
    echo "Active project task index missing: docs/projects/$activeProject/tasks.md"
    fail=1
  else
    project_status="docs/projects/$activeProject/status.md"
    if [[ -f "$project_status" ]]; then
      validate_tasks_file \
        "docs/projects/$activeProject/tasks.md" \
        "$(value_for current-phase "$project_status")" \
        "$(value_for phase-result "$project_status")"
    else
      validate_tasks_file "docs/projects/$activeProject/tasks.md" phase-8-final-check PASS
    fi
  fi

  if [[ -f "docs/projects/$activeProject/status.md" ]]; then
    validate_project_context \
      "docs/projects/$activeProject" \
      "$(value_for current-phase "docs/projects/$activeProject/status.md")" \
      "$(value_for phase-result "docs/projects/$activeProject/status.md")"
  fi
fi

while IFS= read -r -d '' project_status; do
  validate_status_file "$project_status"
  project_dir="${project_status%/status.md}"
  validate_project_context \
    "$project_dir" \
    "$(value_for current-phase "$project_status")" \
    "$(value_for phase-result "$project_status")"
done < <(find docs/projects -mindepth 2 -maxdepth 2 -name 'status.md' -print0 2>/dev/null || true)

while IFS= read -r -d '' tasks_file; do
  project_status="${tasks_file%/tasks.md}/status.md"
  if [[ -f "$project_status" ]]; then
    validate_tasks_file \
      "$tasks_file" \
      "$(value_for current-phase "$project_status")" \
      "$(value_for phase-result "$project_status")"
  else
    validate_tasks_file "$tasks_file" phase-8-final-check PASS
  fi
done < <(find docs/projects -mindepth 2 -maxdepth 2 -name 'tasks.md' -print0 2>/dev/null || true)

exit "$fail"
